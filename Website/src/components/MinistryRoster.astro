---
import type { CollectionEntry } from 'astro:content';
import { useTranslations, type Lang, type UiKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  ministry: CollectionEntry<'ministries'>;
}

const { lang, ministry } = Astro.props;
const t = useTranslations(lang);

const data = ministry.data;
const title = t(`ministry.${data.id}` as UiKey);

// Leaders and assistants are named with their role; everyone else keeps the
// order they appear in roster.yaml.
const leads = data.members.filter((member) => member.role !== 'member');
const members = data.members.filter((member) => member.role === 'member');
---

<section id={data.id} class="scroll-mt-24 church-card mb-8" aria-labelledby={`ministry-${data.id}`}>
  <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-rule">
    <div>
      <span class="text-xs font-bold uppercase tracking-wider text-magenta">Ministry</span>
      <h3 id={`ministry-${data.id}`} class="font-heading text-2xl font-bold text-ink">{title}</h3>
    </div>
    <span class="pill-badge bg-purple/10 text-purple border border-purple/20">
      {leads.length + members.length} Active Members
    </span>
  </div>

  {data.description && <p class="mt-3 max-w-[60ch] text-sm leading-relaxed text-ink-soft">{data.description[lang]}</p>}

  <!-- Leadership -->
  <div class="mt-6 grid gap-3 sm:grid-cols-2">
    {
      leads.map((member) => (
        <div class="flex items-center gap-3 p-3 rounded-xl bg-paper-shade border border-rule/70">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-magenta/15 text-magenta font-bold text-xs">
            {member.role === 'leader' ? 'L' : 'A'}
          </div>
          <div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-magenta block">
              {t(`role.${member.role}` as UiKey)}
            </span>
            <span class="font-heading font-bold text-base text-ink">
              {member.name}
            </span>
            {member.detail && <span class="ms-1.5 text-xs text-ink-muted">({member.detail})</span>}
          </div>
        </div>
      ))
    }
  </div>

  <!-- General Members -->
  {
    members.length > 0 && (
      <div class="mt-6 pt-5 border-t border-rule/60">
        <h4 class="text-xs font-bold uppercase tracking-wider text-ink-muted mb-3">{t('role.member')}s</h4>
        <div class="flex flex-wrap gap-2">
          {members.map((member) => (
            <span class="inline-flex items-center gap-1.5 rounded-full bg-paper px-3 py-1 text-xs font-medium text-ink-soft border border-rule hover:border-gold/80 transition-colors">
              <span class="h-1.5 w-1.5 rounded-full bg-gold"></span>
              <span>{member.name}</span>
              {member.detail && <span class="text-ink-muted text-[10px]">({member.detail})</span>}
            </span>
          ))}
        </div>
      </div>
    )
  }
</section>
