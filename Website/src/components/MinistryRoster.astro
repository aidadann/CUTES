---
import type { CollectionEntry } from 'astro:content';
import { useTranslations, type Lang, type UiKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  ministry: CollectionEntry<'ministries'>;
}

const { lang, ministry } = Astro.props;
const t = useTranslations(lang);

const data = ministry.data;
const title = t(`ministry.${data.id}` as UiKey);

// Leaders and assistants are named with their role; everyone else keeps the
// order they appear in roster.yaml.
const leads = data.members.filter((member) => member.role !== 'member');
const members = data.members.filter((member) => member.role === 'member');
---

{/* Set like a printed roster: a rule, a heading, names in columns. Sixty
    names in sixty identical bordered cards is unreadable. */}
<section id={data.id} class="scroll-mt-8 border-t border-ink pt-5" aria-labelledby={`ministry-${data.id}`}>
  <h3 id={`ministry-${data.id}`} class="text-xl font-semibold">{title}</h3>

  {data.description && <p class="mt-1.5 max-w-[56ch] font-serif text-ink-soft">{data.description[lang]}</p>}

  <dl class="mt-5">
    {
      leads.map((member) => (
        <div class="flex flex-wrap items-baseline gap-x-4 border-b border-rule py-2.5">
          <dt class="w-40 shrink-0 text-[0.9375rem]" style="color: var(--color-cutes)">
            {t(`role.${member.role}` as UiKey)}
          </dt>
          <dd class="font-semibold">
            {member.name}
            {member.detail && <span class="ms-2 font-normal text-sm text-ink-soft">{member.detail}</span>}
          </dd>
        </div>
      ))
    }
  </dl>

  {
    members.length > 0 && (
      <div class="mt-5">
        <h4 class="text-[0.9375rem] text-ink-soft">{t('role.member')}</h4>
        <ul class="mt-2 columns-2 gap-8 text-[0.9375rem] [column-fill:balance]">
          {members.map((member) => (
            <li class="break-inside-avoid py-0.5">
              {member.name}
              {member.detail && <span class="block text-sm text-ink-soft">{member.detail}</span>}
            </li>
          ))}
        </ul>
      </div>
    )
  }
</section>
