---
import { site } from '../data/site';
import { useTranslations, type Lang } from '../i18n/ui';
import { localePath } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

// Laid out like the back page of a parish bulletin: everything you might need
// to ring, visit or find, in one dense block.
const columns = [
  {
    heading: t('footer.parish'),
    links: [
      { label: t('nav.bulletin'), href: localePath(lang, 'bulletin') },
      { label: t('nav.massSchedule'), href: localePath(lang, 'mass-schedule') },
      { label: t('nav.parishPriest'), href: localePath(lang, 'parish/parish-priest') },
      { label: t('nav.parishHistory'), href: localePath(lang, 'parish/parish-history') },
    ],
  },
  {
    heading: t('services.title'),
    links: [
      { label: t('nav.services'), href: localePath(lang, 'services') },
      { label: t('nav.resources'), href: localePath(lang, 'resources') },
      { label: t('nav.contact'), href: localePath(lang, 'contact') },
    ],
  },
  {
    heading: t('footer.community'),
    links: [
      { label: t('nav.aboutCutes'), href: localePath(lang, 'cutes') },
      { label: t('nav.committee'), href: localePath(lang, 'cutes/committee') },
      { label: t('nav.events'), href: localePath(lang, 'events') },
      { label: t('nav.gallery'), href: localePath(lang, 'gallery') },
    ],
  },
];

const socials = Object.entries(site.social).filter(([, url]) => url !== '');
---

<footer class="mt-24 border-t-[3px] border-ink" data-print="hide">
  <div class="mx-auto max-w-[80rem] px-gutter py-14">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-[1.4fr_repeat(3,1fr)]">
      <div>
        <p class="text-xl font-semibold">{site.parishName}</p>

        <address class="mt-4 not-italic leading-relaxed text-ink-soft">
          {site.address.line2}<br />
          {site.address.postcode}
          {site.address.city}<br />
          {site.address.state}
        </address>

        <p class="mt-4">
          <a href={`mailto:${site.email}`} class="link">{site.email}</a><br />
          <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="link tabular">
            {site.phoneDisplay}
          </a>
        </p>

        {
          socials.length > 0 && (
            <p class="mt-4 flex gap-5">
              {socials.map(([name, url]) => (
                <a href={url} rel="noopener noreferrer" target="_blank" class="link capitalize">
                  {name}
                </a>
              ))}
            </p>
          )
        }
      </div>

      {
        columns.map((column) => (
          <nav aria-label={column.heading}>
            <h2 class="text-[0.9375rem] font-semibold">{column.heading}</h2>
            <ul class="mt-3 space-y-2 text-[0.9375rem] text-ink-soft">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="no-underline hover:underline">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="mt-14 border-t border-rule pt-5 text-[0.8125rem] text-ink-soft">
      <p>{site.diocese}</p>
      <p class="mt-1">
        &copy; {year} {site.parishName}, {site.town}. {t('footer.rights')}
      </p>
      <p class="mt-1">{t('footer.builtBy')}</p>
    </div>
  </div>
</footer>
