---
import { site } from '../data/site';
import { useTranslations, type Lang, type UiKey } from '../i18n/ui';
import { localePath } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

// Laid out like the back page of a parish bulletin: everything you might need
// to ring, visit or find, in one dense block.
const columns = [
  {
    heading: t('footer.parish'),
    links: [
      { label: t('nav.bulletin'), href: localePath(lang, 'bulletin') },
      { label: t('nav.massSchedule'), href: localePath(lang, 'mass-schedule') },
      { label: t('nav.parishPriest'), href: localePath(lang, 'parish/parish-priest') },
      { label: t('nav.parishHistory'), href: localePath(lang, 'parish/parish-history') },
    ],
  },
  {
    heading: t('services.title'),
    links: [
      { label: t('nav.services'), href: localePath(lang, 'services') },
      { label: t('nav.resources'), href: localePath(lang, 'resources') },
      { label: t('nav.contact'), href: localePath(lang, 'contact') },
    ],
  },
  {
    heading: t('footer.community'),
    links: [
      { label: t('nav.aboutCutes'), href: localePath(lang, 'cutes') },
      { label: t('nav.committee'), href: localePath(lang, 'cutes/committee') },
      { label: t('nav.bec'), href: localePath(lang, 'cutes/bec') },
      { label: t('nav.events'), href: localePath(lang, 'events') },
    ],
  },
];
---

<footer class="mt-24 border-t border-rule bg-paper-card" data-print="hide">
  <!-- Top decorative accent -->
  <div class="h-1 bg-gradient-to-r from-gold via-magenta to-purple"></div>

  <div class="mx-auto max-w-[84rem] px-gutter py-16">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-[1.5fr_repeat(3,1fr)]">
      <!-- Parish Brand info -->
      <div>
        <div class="flex items-center gap-3">
          <img
            src="/logo.jpg"
            alt="CUTES Logo"
            class="h-12 w-12 rounded-full object-cover shadow-sm ring-2 ring-gold/40"
            width="48"
            height="48"
          />
          <div>
            <h3 class="text-xl font-bold font-heading text-ink">{site.churchName}</h3>
            <p class="text-xs font-semibold text-purple uppercase tracking-wider">
              {site.communityFullName}
            </p>
          </div>
        </div>

        <address class="mt-5 not-italic text-sm leading-relaxed text-ink-soft">
          <div class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-magenta shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>
              {site.address.line1},<br />
              {site.address.line2}, {site.address.postcode} {site.address.city},<br />
              {site.address.state}
            </span>
          </div>
        </address>

        <div class="mt-4 space-y-2 text-sm text-ink-soft">
          <p class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-purple shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href={`mailto:${site.email}`} class="hover:text-magenta transition-colors">{site.email}</a>
          </p>

          <ul class="space-y-1.5">
            {site.council.map((member) => (
              <li class="flex items-baseline gap-2.5">
                <span class="h-1 w-1 shrink-0 translate-y-[-2px] rounded-full bg-gold"></span>
                <span>
                  <a href={`tel:${member.phone}`} class="tabular font-medium hover:text-magenta transition-colors">
                    {member.phoneDisplay}
                  </a>
                  <span class="block text-xs text-ink-muted">
                    {member.name} — {t(member.roleKey as UiKey)}
                  </span>
                </span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Social Icons Row like Fellowship Church -->
        <div class="mt-6 flex items-center gap-3 text-ink-soft">
          <a
            href={site.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-9 w-9 items-center justify-center rounded-full bg-paper-shade border border-rule hover:bg-magenta hover:text-white transition-all shadow-xs"
            aria-label="Google Maps"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
            </svg>
          </a>

          <a
            href={site.social.instagram.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-9 w-9 items-center justify-center rounded-full bg-paper-shade border border-rule hover:bg-magenta hover:text-white transition-all shadow-xs"
            aria-label={`Instagram — @${site.social.instagram.handle}`}
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
            </svg>
          </a>

          <a
            href={site.social.tiktok.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-9 w-9 items-center justify-center rounded-full bg-paper-shade border border-rule hover:bg-purple hover:text-white transition-all shadow-xs"
            aria-label={`TikTok — @${site.social.tiktok.handle}`}
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Navigation Columns -->
      {
        columns.map((column) => (
          <nav aria-label={column.heading} class="space-y-4">
            <h4 class="text-sm font-bold font-heading uppercase tracking-wider text-purple">
              {column.heading}
            </h4>
            <ul class="space-y-2.5 text-sm font-medium text-ink-soft">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="hover:text-magenta transition-colors inline-flex items-center gap-1.5">
                    <span class="h-1 w-1 rounded-full bg-gold"></span>
                    <span>{link.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <!-- Bottom Copyright & Diocese -->
    <div class="mt-14 pt-6 border-t border-rule flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-ink-muted">
      <p class="font-medium">
        &copy; {year} {site.parishName}, {site.town}. {t('footer.rights')}
      </p>
      <div class="flex items-center gap-4">
        <span class="inline-flex items-center gap-1.5">
          <span class="h-1.5 w-1.5 rounded-full bg-gold"></span>
          {site.diocese}
        </span>
      </div>
    </div>
  </div>
</footer>
