---
import { useTranslations, type Lang } from '../i18n/ui';
import { localePath } from '../i18n/utils';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  lang: Lang;
  title: string;
  lead?: string;
  /** A fact that belongs above the title — a date, a count, a notice period. */
  note?: string;
  crumbs?: Crumb[];
  /** CUTES pages take the community's colour instead of the season's. */
  accent?: 'season' | 'cutes';
}

const { lang, title, lead, note, crumbs = [] } = Astro.props;
const t = useTranslations(lang);
---

<div class="relative overflow-hidden bg-gradient-to-b from-paper-shade/60 to-paper border-b border-rule/60 pb-12 pt-10 sm:pb-16 sm:pt-14">
  <div class="mx-auto max-w-[84rem] px-gutter">
    {
      crumbs.length > 0 && (
        <nav aria-label={t('common.breadcrumb')} class="mb-6 text-xs font-semibold uppercase tracking-wider" data-print="hide">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-ink-muted">
            <li>
              <a href={localePath(lang, '')} class="hover:text-magenta transition-colors">
                {t('site.home')}
              </a>
            </li>
            {crumbs.map((crumb) => (
              <>
                <li aria-hidden="true" class="text-gold">
                  /
                </li>
                <li>
                  {crumb.href ? (
                    <a href={crumb.href} class="hover:text-magenta transition-colors">
                      {crumb.label}
                    </a>
                  ) : (
                    <span class="text-ink font-bold">{crumb.label}</span>
                  )}
                </li>
              </>
            ))}
          </ol>
        </nav>
      )
    }

    {
      note && (
        <span class="inline-flex items-center gap-1.5 rounded-full bg-gold/15 px-3 py-1 text-xs font-bold uppercase tracking-wider text-gold-hover mb-3 border border-gold/30">
          <span class="h-1.5 w-1.5 rounded-full bg-gold"></span>
          <span>{note}</span>
        </span>
      )
    }

    <h1 class="font-heading text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-ink">
      {title}
    </h1>

    {
      lead && (
        <p class="mt-4 max-w-[56ch] text-base sm:text-xl font-normal leading-relaxed text-ink-soft">
          {lead}
        </p>
      )
    }
  </div>
</div>
