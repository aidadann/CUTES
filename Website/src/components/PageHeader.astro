---
import { useTranslations, type Lang } from '../i18n/ui';
import { localePath } from '../i18n/utils';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  lang: Lang;
  title: string;
  lead?: string;
  /** Small label above the title — section name, date, ministry. */
  kicker?: string;
  /** Breadcrumb trail, excluding Home and the current page. */
  crumbs?: Crumb[];
  /** CUTES pages use the magenta accent, parish pages the purple. */
  accent?: 'purple' | 'magenta';
}

const { lang, title, lead, kicker, crumbs = [], accent = 'purple' } = Astro.props;
const t = useTranslations(lang);
const accentClass = accent === 'magenta' ? 'text-accent-cutes' : 'text-brand-gold-ink';
---

<div class="border-b border-line bg-surface-sunken">
  <div class="mx-auto max-w-6xl px-gutter pb-10 pt-8 sm:pb-14 sm:pt-12">
    {
      (crumbs.length > 0 || kicker) && (
        <nav aria-label={t('common.breadcrumb')} class="mb-4 text-xs" data-print="hide">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-content-muted">
            <li>
              <a href={localePath(lang, '')} class="link-quiet hover:text-accent">
                {t('site.home')}
              </a>
            </li>
            {crumbs.map((crumb) => (
              <>
                <li aria-hidden="true" class="text-line-strong">
                  /
                </li>
                <li>
                  {crumb.href ? (
                    <a href={crumb.href} class="link-quiet hover:text-accent">
                      {crumb.label}
                    </a>
                  ) : (
                    <span>{crumb.label}</span>
                  )}
                </li>
              </>
            ))}
          </ol>
        </nav>
      )
    }

    {
      kicker && (
        <p class:list={['mb-2 text-xs font-semibold uppercase tracking-[0.16em]', accentClass]}>
          {kicker}
        </p>
      )
    }

    <h1 class="font-display text-3xl font-semibold sm:text-4xl md:text-[2.75rem]">{title}</h1>

    {lead && <p class="mt-3 max-w-2xl text-base text-content-muted sm:text-lg">{lead}</p>}
  </div>
</div>
