---
import { useTranslations, type Lang } from '../i18n/ui';
import { localePath } from '../i18n/utils';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  lang: Lang;
  title: string;
  lead?: string;
  /** A fact that belongs above the title — a date, a count, a notice period. */
  note?: string;
  crumbs?: Crumb[];
  /** CUTES pages take the community's colour instead of the season's. */
  accent?: 'season' | 'cutes';
}

const { lang, title, lead, note, crumbs = [], accent = 'season' } = Astro.props;
const t = useTranslations(lang);
const accentVar = accent === 'cutes' ? 'var(--color-cutes)' : 'var(--season-ink)';
---

<div class="mx-auto max-w-[80rem] px-gutter pb-8 pt-8 sm:pb-12 sm:pt-12">
  {
    crumbs.length > 0 && (
      <nav aria-label={t('common.breadcrumb')} class="mb-5 text-[0.875rem]" data-print="hide">
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-ink-soft">
          <li>
            <a href={localePath(lang, '')} class="no-underline hover:underline">
              {t('site.home')}
            </a>
          </li>
          {crumbs.map((crumb) => (
            <>
              <li aria-hidden="true" class="text-rule-strong">
                /
              </li>
              <li>
                {crumb.href ? (
                  <a href={crumb.href} class="no-underline hover:underline">
                    {crumb.label}
                  </a>
                ) : (
                  <span>{crumb.label}</span>
                )}
              </li>
            </>
          ))}
        </ol>
      </nav>
    )
  }

  {note && <p class="mb-2 text-[0.9375rem] font-semibold" style={`color: ${accentVar}`}>{note}</p>}

  <h1 class="max-w-[20ch] text-[clamp(2rem,1.4rem+2.6vw,3.5rem)] font-semibold">{title}</h1>

  {
    lead && (
      <p class="mt-4 max-w-[54ch] font-serif text-lg leading-relaxed text-ink-soft">{lead}</p>
    )
  }
</div>
