---
import { getCollection } from 'astro:content';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Show only the entries flagged `highlight: true`. */
  highlightOnly?: boolean;
  kind?: 'mass' | 'confession' | 'adoration' | 'devotion';
}

const { lang, highlightOnly = false, kind } = Astro.props;
const t = useTranslations(lang);

const dayNames: Record<string, { en: string; ms: string }> = {
  monday: { en: 'Monday', ms: 'Isnin' },
  tuesday: { en: 'Tuesday', ms: 'Selasa' },
  wednesday: { en: 'Wednesday', ms: 'Rabu' },
  thursday: { en: 'Thursday', ms: 'Khamis' },
  friday: { en: 'Friday', ms: 'Jumaat' },
  saturday: { en: 'Saturday', ms: 'Sabtu' },
  sunday: { en: 'Sunday', ms: 'Ahad' },
  'first-friday': { en: 'First Friday', ms: 'Jumaat Pertama' },
  weekday: { en: 'Weekdays', ms: 'Hari biasa' },
};

const all = await getCollection('massTimes');
const rows = all
  .filter((entry) => (highlightOnly ? entry.data.highlight : true))
  .filter((entry) => (kind ? entry.data.kind === kind : true))
  .sort((a, b) => a.data.order - b.data.order);
---

{
  rows.length === 0 ? (
    <div class="rounded-2xl border border-rule bg-paper-shade p-8 text-center text-ink-soft">
      <p>{t('schedule.empty')}</p>
    </div>
  ) : (
    <div class="space-y-3">
      {rows.map((row) => (
        <div class="church-card !p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 border border-rule/70 hover:border-gold/80 transition-all">
          <div class="flex items-center gap-4">
            <!-- Day indicator badge -->
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-purple/10 text-purple font-heading font-bold text-sm uppercase">
              {dayNames[row.data.day]?.[lang]?.slice(0, 3) ?? row.data.day.slice(0, 3)}
            </div>
            <div>
              <p class="font-heading text-lg font-bold text-ink">
                {dayNames[row.data.day]?.[lang] ?? row.data.day}
              </p>
              <p class="text-xs text-ink-soft flex items-center gap-1.5 mt-0.5">
                <span class="inline-block h-1.5 w-1.5 rounded-full bg-gold"></span>
                <span>{row.data.language}</span>
                {row.data.note && <span class="text-ink-muted">({row.data.note[lang]})</span>}
              </p>
            </div>
          </div>

          <!-- Time & Icon Pill -->
          <div class="flex items-center gap-2 self-start sm:self-auto">
            <span class="pill-badge bg-paper-shade border border-rule text-purple font-heading text-base px-4 py-2">
              <svg class="w-4 h-4 text-magenta" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="clock">{row.data.time}</span>
            </span>
          </div>
        </div>
      ))}
    </div>
  )
}
