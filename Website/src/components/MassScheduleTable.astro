---
import { getCollection } from 'astro:content';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Show only the entries flagged `highlight: true`. */
  highlightOnly?: boolean;
  kind?: 'mass' | 'confession' | 'adoration' | 'devotion';
}

const { lang, highlightOnly = false, kind } = Astro.props;
const t = useTranslations(lang);

const dayNames: Record<string, { en: string; ms: string }> = {
  monday: { en: 'Monday', ms: 'Isnin' },
  tuesday: { en: 'Tuesday', ms: 'Selasa' },
  wednesday: { en: 'Wednesday', ms: 'Rabu' },
  thursday: { en: 'Thursday', ms: 'Khamis' },
  friday: { en: 'Friday', ms: 'Jumaat' },
  saturday: { en: 'Saturday', ms: 'Sabtu' },
  sunday: { en: 'Sunday', ms: 'Ahad' },
  'first-friday': { en: 'First Friday', ms: 'Jumaat Pertama' },
  weekday: { en: 'Weekdays', ms: 'Hari biasa' },
};

const all = await getCollection('massTimes');
const rows = all
  .filter((entry) => (highlightOnly ? entry.data.highlight : true))
  .filter((entry) => (kind ? entry.data.kind === kind : true))
  .sort((a, b) => a.data.order - b.data.order);
---

{
  rows.length === 0 ? (
    <p class="text-ink-soft">{t('schedule.empty')}</p>
  ) : (
    /* A list rather than a table: the day, the time and the language are one
       statement, and on a phone a three-column table either scrolls sideways
       or drops a column. */
    <ul class="border-t border-rule">
      {rows.map((row) => (
        <li class="grid gap-x-8 gap-y-1 border-b border-rule py-4 sm:grid-cols-[10rem_7rem_1fr]">
          <span class="font-semibold">{dayNames[row.data.day]?.[lang] ?? row.data.day}</span>
          <span class="clock tabular text-lg leading-tight">{row.data.time}</span>
          <span class="text-ink-soft">
            {row.data.language}
            {row.data.note && <span class="block text-sm">{row.data.note[lang]}</span>}
          </span>
        </li>
      ))}
    </ul>
  )
}
