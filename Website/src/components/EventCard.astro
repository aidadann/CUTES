---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { useTranslations, type Lang } from '../i18n/ui';
import { formatDateRange, localePath } from '../i18n/utils';
import { slugOf } from '../lib/content';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'events'>;
  past?: boolean;
}

const { lang, entry, past = false } = Astro.props;
const t = useTranslations(lang);
const href = localePath(lang, `events/${slugOf(entry.id)}`);
const when = formatDateRange(entry.data.startDate, entry.data.endDate, lang);
---

{/* A dated row, not a card. The date is the thing people scan for, so it gets
    the left margin and the season's colour; the photograph, when there is one,
    sits to the right rather than being a mandatory header image. */}
<article class="border-b border-rule">
  <a href={href} class="grid gap-x-8 gap-y-3 py-7 no-underline sm:grid-cols-[13rem_1fr]">
    <time
      datetime={entry.data.startDate.toISOString().slice(0, 10)}
      class:list={['text-[0.9375rem] font-semibold', past && 'text-ink-soft']}
      style={past ? undefined : 'color: var(--season-ink)'}
    >
      {when}
    </time>

    <div class="grid gap-6 sm:grid-cols-[1fr_auto] sm:items-start">
      <div>
        <h3 class="text-xl font-semibold sm:text-2xl">{entry.data.title}</h3>
        <p class="mt-1.5 max-w-[58ch] font-serif text-ink-soft">{entry.data.summary}</p>
        <p class="mt-2 text-sm text-ink-soft">
          <span class="sr-only">{t('events.where')}: </span>
          {entry.data.location}
        </p>
      </div>

      {
        entry.data.cover && (
          <Image
            src={entry.data.cover}
            alt={entry.data.coverAlt ?? ''}
            width={320}
            height={214}
            loading="lazy"
            decoding="async"
            class="h-32 w-full object-cover sm:w-48"
          />
        )
      }
    </div>
  </a>
</article>
