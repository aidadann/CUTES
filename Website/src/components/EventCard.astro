---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { useTranslations, type Lang } from '../i18n/ui';
import { formatDateRange, localePath } from '../i18n/utils';
import { slugOf } from '../lib/content';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'events'>;
  past?: boolean;
}

const { lang, entry, past = false } = Astro.props;
const t = useTranslations(lang);
const href = localePath(lang, `events/${slugOf(entry.id)}`);
const when = formatDateRange(entry.data.startDate, entry.data.endDate, lang);
---

<article class="church-card group flex flex-col justify-between overflow-hidden">
  <div>
    {
      entry.data.cover && (
        <div class="mb-5 overflow-hidden rounded-2xl -mx-2 -mt-2">
          <Image
            src={entry.data.cover}
            alt={entry.data.coverAlt ?? ''}
            width={600}
            height={340}
            loading="lazy"
            decoding="async"
            class="h-48 w-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
        </div>
      )
    }

    <div class="flex items-center gap-2 mb-3">
      <span class:list={[
        'pill-badge',
        past ? 'bg-paper-shade text-ink-muted border border-rule' : 'bg-magenta/10 text-magenta border border-magenta/20'
      ]}>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <time datetime={entry.data.startDate.toISOString().slice(0, 10)}>
          {when}
        </time>
      </span>
    </div>

    <h3 class="font-heading text-xl sm:text-2xl font-bold text-ink group-hover:text-magenta transition-colors">
      <a href={href} class="no-underline">
        {entry.data.title}
      </a>
    </h3>

    <p class="mt-2 text-sm text-ink-soft line-clamp-3 leading-relaxed">
      {entry.data.summary}
    </p>
  </div>

  <div class="mt-6 pt-4 border-t border-rule flex items-center justify-between text-xs text-ink-muted">
    <span class="flex items-center gap-1.5">
      <svg class="w-3.5 h-3.5 text-purple shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      <span class="truncate max-w-[20ch]">{entry.data.location}</span>
    </span>

    <a href={href} class="font-bold text-purple group-hover:text-magenta transition-colors inline-flex items-center gap-1">
      <span>{t('common.readMore')}</span>
      <span>&rarr;</span>
    </a>
  </div>
</article>
