---
import { site } from '../data/site';
import { nav, type NavItem } from '../i18n/nav';
import { languageShort, useTranslations, type Lang, type UiKey } from '../i18n/ui';
import { localePath, otherLang, switchLangPath } from '../i18n/utils';
import { localized, slugOf } from '../lib/content';
import type { LiturgicalDay } from '../lib/liturgical';

interface Props {
  lang: Lang;
  /** Current path below the language segment, used to mark the active item. */
  path: string;
  season: LiturgicalDay;
}

const { lang, path, season } = Astro.props;
const t = useTranslations(lang);
const other = otherLang(lang);

// Sacrament and prayer menus come from the content collections so a new
// Markdown file appears in the navigation without a second edit.
const [services, resources] = await Promise.all([
  localized('services', lang),
  localized('resources', lang),
]);

const dynamicChildren = {
  services: services.map((entry) => ({
    label: entry.data.title,
    href: localePath(lang, `services/${slugOf(entry.id)}`),
    path: `services/${slugOf(entry.id)}`,
  })),
  resources: resources.map((entry) => ({
    label: entry.data.title,
    href: localePath(lang, `resources/${slugOf(entry.id)}`),
    path: `resources/${slugOf(entry.id)}`,
  })),
};

type Resolved = {
  label: string;
  href: string;
  path: string;
  children: { label: string; href: string; path: string }[];
};

const items: Resolved[] = nav
  .filter((item) => item.path !== '')
  .map((item: NavItem) => {
    const children = item.dynamic
      ? [
          {
            label: t(`${item.dynamic}.all` as UiKey),
            href: localePath(lang, item.path),
            path: item.path,
          },
          ...dynamicChildren[item.dynamic],
        ]
      : (item.children ?? []).map((child) => ({
          label: t(child.key),
          href: localePath(lang, child.path),
          path: child.path,
        }));

    return {
      label: t(item.key),
      href: localePath(lang, item.path),
      path: item.path,
      children,
    };
  });

const isActive = (item: Resolved) => {
  const root = item.path.split('/')[0]!;
  if (path === item.path || path === root || path.startsWith(`${root}/`)) return true;
  // The bulletin and the mass schedule sit at the top level but belong under
  // "Parish" in the menu, so match on the children too.
  return item.children.some((child) => path === child.path || path.startsWith(`${child.path}/`));
};
---

<header data-print="hide">
  <div class="mx-auto flex max-w-[80rem] items-center gap-6 px-gutter py-4">
    <a href={localePath(lang, '')} class="flex shrink-0 items-baseline gap-2.5 no-underline">
      <span class="text-[1.0625rem] font-semibold leading-none tracking-tight sm:text-lg">
        {site.parishShortName}
      </span>
      <span class="hidden text-sm text-ink-soft sm:inline">{site.town}</span>
    </a>

    <div class="grow"></div>

    <nav class="hidden lg:block" aria-label={t('site.menu')}>
      <ul class="flex items-center gap-6 text-[0.9375rem]">
        {
          items.map((item) => (
            <li class="relative">
              {item.children.length === 0 ? (
                <a
                  href={item.href}
                  class:list={[
                    'py-2 no-underline decoration-2 underline-offset-[6px] hover:underline',
                    isActive(item) && 'underline',
                  ]}
                  style={isActive(item) ? 'text-decoration-color: var(--season)' : undefined}
                  aria-current={isActive(item) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ) : (
                <details data-nav-dropdown>
                  <summary
                    class:list={[
                      'cursor-pointer list-none py-2 decoration-2 underline-offset-[6px] hover:underline',
                      isActive(item) && 'underline',
                    ]}
                    style={isActive(item) ? 'text-decoration-color: var(--season)' : undefined}
                  >
                    {item.label}
                  </summary>
                  <ul class="absolute start-0 z-50 mt-2 min-w-60 bg-paper py-2 shadow-[0_0_0_1px_var(--color-rule)]">
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          class:list={[
                            'block px-4 py-2 no-underline hover:bg-paper-shade',
                            path === child.path && 'font-semibold',
                          ]}
                          aria-current={path === child.path ? 'page' : undefined}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    {/* Both languages sit side by side rather than behind a toggle: in this
        parish neither one is the translation of the other. */}
    <p class="flex shrink-0 items-center gap-1.5 text-[0.9375rem]">
      <span class="font-semibold" aria-current="true">{languageShort[lang]}</span>
      <span class="text-rule-strong" aria-hidden="true">/</span>
      <a
        href={switchLangPath(Astro.url.pathname, other)}
        hreflang={other}
        lang={other}
        rel="alternate"
        class="text-ink-soft no-underline hover:underline"
        title={t('site.switchTo')}
      >
        {languageShort[other]}
      </a>
    </p>

    <details class="lg:hidden" data-mobile-menu>
      <summary
        class="cursor-pointer list-none px-1 py-1.5 text-[0.9375rem] font-semibold"
        aria-label={t('site.menu')}
      >
        {t('site.menu')}
      </summary>

      <nav
        class="absolute inset-x-0 top-full z-50 max-h-[calc(100dvh-4rem)] overflow-y-auto border-t border-rule bg-paper px-gutter pb-10 pt-4"
        aria-label={t('site.menu')}
      >
        <ul class="mx-auto max-w-[80rem]">
          {
            items.map((item) => (
              <li class="border-b border-rule py-3 last:border-0">
                <a
                  href={item.href}
                  class:list={['block text-xl font-semibold no-underline', isActive(item) && 'underline']}
                  style={isActive(item) ? 'text-decoration-color: var(--season)' : undefined}
                >
                  {item.label}
                </a>
                {item.children.length > 0 && (
                  <ul class="mt-1.5 flex flex-wrap gap-x-5 gap-y-1 text-[0.9375rem] text-ink-soft">
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href} class="no-underline hover:underline">
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>

  {/* The season's colour, stated plainly. It is the only ornament on the page
      and it is also a fact: this is what colour the vestments are today. */}
  <div class="rule-season"></div>
  <p class="mx-auto max-w-[80rem] px-gutter pb-1 pt-1.5 text-[0.8125rem] text-ink-soft">
    {season.name[lang]}
  </p>
</header>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
  summary::marker {
    content: '';
  }
</style>

<script>
  // Progressive enhancement only. Without this the menus still open and close
  // by click, they just do not close when you look away.
  const closeAll = (except?: Element) => {
    document
      .querySelectorAll<HTMLDetailsElement>('[data-nav-dropdown][open], [data-mobile-menu][open]')
      .forEach((el) => {
        if (el !== except) el.open = false;
      });
  };

  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    closeAll(target?.closest('[data-nav-dropdown], [data-mobile-menu]') ?? undefined);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const open = document.querySelector<HTMLDetailsElement>(
      '[data-nav-dropdown][open], [data-mobile-menu][open]',
    );
    if (!open) return;
    open.open = false;
    open.querySelector('summary')?.focus();
  });
</script>
