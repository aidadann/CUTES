---
import { site } from '../data/site';
import { nav, type NavItem } from '../i18n/nav';
import { languageShort, useTranslations, type Lang, type UiKey } from '../i18n/ui';
import { localePath, otherLang, switchLangPath } from '../i18n/utils';
import { localized, slugOf } from '../lib/content';
import type { LiturgicalDay } from '../lib/liturgical';

interface Props {
  lang: Lang;
  /** Current path below the language segment, used to mark the active item. */
  path: string;
  season: LiturgicalDay;
}

const { lang, path } = Astro.props;
const t = useTranslations(lang);
const other = otherLang(lang);

// Sacrament and prayer menus come from the content collections so a new
// Markdown file appears in the navigation without a second edit.
const [services, resources] = await Promise.all([
  localized('services', lang),
  localized('resources', lang),
]);

const dynamicChildren = {
  services: services.map((entry) => ({
    label: entry.data.title,
    href: localePath(lang, `services/${slugOf(entry.id)}`),
    path: `services/${slugOf(entry.id)}`,
  })),
  resources: resources.map((entry) => ({
    label: entry.data.title,
    href: localePath(lang, `resources/${slugOf(entry.id)}`),
    path: `resources/${slugOf(entry.id)}`,
  })),
};

type Resolved = {
  label: string;
  href: string;
  path: string;
  children: { label: string; href: string; path: string }[];
};

const items: Resolved[] = nav
  .filter((item) => item.path !== '')
  .map((item: NavItem) => {
    const children = item.dynamic
      ? [
          {
            label: t(`${item.dynamic}.all` as UiKey),
            href: localePath(lang, item.path),
            path: item.path,
          },
          ...dynamicChildren[item.dynamic],
        ]
      : (item.children ?? []).map((child) => ({
          label: t(child.key),
          href: localePath(lang, child.path),
          path: child.path,
        }));

    return {
      label: t(item.key),
      href: localePath(lang, item.path),
      path: item.path,
      children,
    };
  });

const isActive = (item: Resolved) => {
  const root = item.path.split('/')[0]!;
  if (path === item.path || path === root || path.startsWith(`${root}/`)) return true;
  // The bulletin and the mass schedule sit at the top level but belong under
  // "Parish" in the menu, so match on the children too.
  return item.children.some((child) => path === child.path || path.startsWith(`${child.path}/`));
};
---

<header data-print="hide" class="sticky top-0 z-50 bg-paper/95 backdrop-blur-md transition-all duration-200 border-b border-rule">
  <div class="mx-auto flex max-w-[84rem] items-center justify-between gap-6 px-gutter py-4">
    <!-- LEFT: Church Logo / Church Name -->
    <a href={localePath(lang, '')} class="group flex shrink-0 items-center gap-3.5 no-underline">
      <img
        src="/logo.jpg"
        alt="Most Holy Redeemer"
        class="h-10 w-10 rounded-full object-cover border border-rule transition-transform group-hover:scale-105"
        width="40"
        height="40"
      />
      <div class="flex flex-col">
        <span class="font-heading text-lg sm:text-xl font-bold leading-none tracking-tight text-ink group-hover:text-ink-soft transition-colors">
          {site.parishShortName}
        </span>
        <span class="text-[11px] font-semibold tracking-widest text-ink-muted uppercase mt-1">
          Tanjung Malim • CUTES
        </span>
      </div>
    </a>

    <!-- CENTER / RIGHT: Editorial Clean Navigation Links -->
    <nav class="hidden lg:block" aria-label={t('site.menu')}>
      <ul class="flex items-center gap-8 text-[0.9375rem] font-medium text-ink">
        {
          items.map((item) => (
            <li class="relative">
              {item.children.length === 0 ? (
                <a
                  href={item.href}
                  class:list={[
                    'relative py-2 tracking-wide transition-colors hover:text-ink-soft',
                    isActive(item) ? 'font-bold text-ink border-b-2 border-ink' : 'text-ink-soft',
                  ]}
                  aria-current={isActive(item) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ) : (
                <details data-nav-dropdown class="group">
                  <summary
                    class:list={[
                      'flex items-center gap-1.5 cursor-pointer list-none py-2 tracking-wide transition-colors hover:text-ink',
                      isActive(item) ? 'font-bold text-ink border-b-2 border-ink' : 'text-ink-soft',
                    ]}
                  >
                    <span>{item.label}</span>
                    <svg
                      class="h-3.5 w-3.5 transition-transform duration-200 group-open:rotate-180 opacity-60"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </summary>
                  <ul class="absolute start-0 z-50 mt-2 min-w-64 border border-rule bg-paper p-2 shadow-lg animate-in fade-in duration-150">
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          class:list={[
                            'block px-3.5 py-2 text-sm font-medium transition-colors hover:bg-paper-shade hover:text-ink',
                            path === child.path ? 'bg-paper-shade font-semibold text-ink' : 'text-ink-soft',
                          ]}
                          aria-current={path === child.path ? 'page' : undefined}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- RIGHT: Language Switcher + Primary CTA "Plan a Visit" -->
    <div class="hidden sm:flex items-center gap-5">
      <!-- Language Switcher -->
      <div class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-ink-muted">
        <a
          href={switchLangPath(path, 'en')}
          class:list={[
            'py-1 px-1.5 transition-colors',
            lang === 'en' ? 'font-bold text-ink border-b border-ink' : 'hover:text-ink',
          ]}
        >
          EN
        </a>
        <span class="text-rule-strong">/</span>
        <a
          href={switchLangPath(path, 'ms')}
          class:list={[
            'py-1 px-1.5 transition-colors',
            lang === 'ms' ? 'font-bold text-ink border-b border-ink' : 'hover:text-ink',
          ]}
        >
          BM
        </a>
      </div>

      <!-- Primary CTA Button (Clean square/slightly rounded) -->
      <a
        href={localePath(lang, 'contact')}
        class="btn-action btn-primary !py-2.5 !px-5 !text-xs"
      >
        <span>{t('home.ctaPlanVisit')}</span>
        <span>&rarr;</span>
      </a>
    </div>

    <!-- Mobile Navigation Toggle -->
    <div class="flex items-center gap-3 lg:hidden">
      <div class="flex items-center gap-1 text-xs font-bold sm:hidden">
        <a
          href={switchLangPath(path, other)}
          class="text-ink font-bold border-b border-ink"
        >
          {languageShort[other]}
        </a>
      </div>

      <details class="lg:hidden relative" data-mobile-menu>
        <summary
          class="cursor-pointer list-none p-2 text-ink hover:bg-paper-shade transition-colors"
          aria-label={t('site.menu')}
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </summary>

        <nav
          class="fixed inset-x-0 top-[65px] h-[calc(100dvh-65px)] overflow-y-auto border-t border-rule bg-paper p-6 shadow-2xl z-50 flex flex-col justify-between"
          aria-label={t('site.menu')}
        >
          <ul class="space-y-4 pt-2">
            {
              items.map((item) => (
                <li class="border-b border-rule/60 pb-3">
                  <a
                    href={item.href}
                    class:list={[
                      'font-heading text-2xl font-bold transition-colors block',
                      isActive(item) ? 'text-ink' : 'text-ink-soft',
                    ]}
                  >
                    {item.label}
                  </a>
                  {item.children.length > 0 && (
                    <ul class="mt-2.5 ms-2 space-y-2 border-s border-rule ps-3 text-sm text-ink-soft">
                      {item.children.map((child) => (
                        <li>
                          <a href={child.href} class="block py-1 hover:text-ink">
                            {child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))
            }
          </ul>

          <div class="pt-6 pb-8 border-t border-rule flex flex-col gap-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold uppercase tracking-wider text-ink-muted">Language:</span>
              <div class="flex items-center gap-2 text-sm font-bold">
                <a href={switchLangPath(path, 'en')} class={lang === 'en' ? 'text-ink underline' : 'text-ink-muted'}>English</a>
                <span>•</span>
                <a href={switchLangPath(path, 'ms')} class={lang === 'ms' ? 'text-ink underline' : 'text-ink-muted'}>Bahasa Malaysia</a>
              </div>
            </div>
            <a href={localePath(lang, 'contact')} class="btn-action btn-primary w-full text-center">
              <span>Plan a Visit &rarr;</span>
            </a>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
  summary::marker {
    content: '';
  }
</style>

<script>
  // Progressive enhancement only. Without this the menus still open and close
  // by click, they just do not close when you look away.
  const closeAll = (except?: Element) => {
    document
      .querySelectorAll<HTMLDetailsElement>('[data-nav-dropdown][open], [data-mobile-menu][open]')
      .forEach((el) => {
        if (el !== except) el.open = false;
      });
  };

  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    closeAll(target?.closest('[data-nav-dropdown], [data-mobile-menu]') ?? undefined);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const open = document.querySelector<HTMLDetailsElement>(
      '[data-nav-dropdown][open], [data-mobile-menu][open]',
    );
    if (!open) return;
    open.open = false;
    open.querySelector('summary')?.focus();
  });
</script>
