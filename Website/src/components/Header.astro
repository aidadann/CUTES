---
import { site } from '../data/site';
import { nav, type NavItem } from '../i18n/nav';
import { languageShort, useTranslations, type Lang, type UiKey } from '../i18n/ui';
import { localePath, otherLang, switchLangPath } from '../i18n/utils';
import { localized, slugOf } from '../lib/content';
import type { LiturgicalDay } from '../lib/liturgical';

interface Props {
  lang: Lang;
  /** Current path below the language segment, used to mark the active item. */
  path: string;
  season: LiturgicalDay;
}

const { lang, path, season } = Astro.props;
const t = useTranslations(lang);
const other = otherLang(lang);

// Sacrament and prayer menus come from the content collections so a new
// Markdown file appears in the navigation without a second edit.
const [services, resources] = await Promise.all([
  localized('services', lang),
  localized('resources', lang),
]);

const dynamicChildren = {
  services: services.map((entry) => ({
    label: entry.data.title,
    href: localePath(lang, `services/${slugOf(entry.id)}`),
    path: `services/${slugOf(entry.id)}`,
  })),
  resources: resources.map((entry) => ({
    label: entry.data.title,
    href: localePath(lang, `resources/${slugOf(entry.id)}`),
    path: `resources/${slugOf(entry.id)}`,
  })),
};

type Resolved = {
  label: string;
  href: string;
  path: string;
  children: { label: string; href: string; path: string }[];
};

const items: Resolved[] = nav
  .filter((item) => item.path !== '')
  .map((item: NavItem) => {
    const children = item.dynamic
      ? [
          {
            label: t(`${item.dynamic}.all` as UiKey),
            href: localePath(lang, item.path),
            path: item.path,
          },
          ...dynamicChildren[item.dynamic],
        ]
      : (item.children ?? []).map((child) => ({
          label: t(child.key),
          href: localePath(lang, child.path),
          path: child.path,
        }));

    return {
      label: t(item.key),
      href: localePath(lang, item.path),
      path: item.path,
      children,
    };
  });

const isActive = (item: Resolved) => {
  const root = item.path.split('/')[0]!;
  if (path === item.path || path === root || path.startsWith(`${root}/`)) return true;
  // The bulletin and the mass schedule sit at the top level but belong under
  // "Parish" in the menu, so match on the children too.
  return item.children.some((child) => path === child.path || path.startsWith(`${child.path}/`));
};
---

<header data-print="hide" class="sticky top-0 z-50 bg-paper/95 backdrop-blur-md transition-all duration-200 border-b border-rule/60 shadow-xs">
  <div class="mx-auto flex max-w-[84rem] items-center justify-between gap-4 px-gutter py-3.5">
    <!-- Brand & Logo -->
    <a href={localePath(lang, '')} class="group flex shrink-0 items-center gap-3 no-underline">
      <img
        src="/logo.jpg"
        alt="CUTES Most Holy Redeemer Logo"
        class="h-10 w-10 sm:h-11 sm:w-11 rounded-full object-cover shadow-sm ring-2 ring-gold/40 transition-transform group-hover:scale-105"
        width="44"
        height="44"
      />
      <div class="flex flex-col">
        <span class="font-heading text-lg sm:text-xl font-bold leading-tight tracking-tight text-ink group-hover:text-magenta transition-colors">
          {site.parishShortName}
        </span>
        <span class="text-xs font-semibold tracking-wider text-purple uppercase">
          CUTES • {site.town}
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:block" aria-label={t('site.menu')}>
      <ul class="flex items-center gap-7 text-[0.9375rem] font-medium text-ink">
        {
          items.map((item) => (
            <li class="relative">
              {item.children.length === 0 ? (
                <a
                  href={item.href}
                  class:list={[
                    'relative py-2.5 font-semibold transition-colors duration-200 hover:text-magenta',
                    isActive(item) ? 'text-magenta font-bold' : 'text-ink-soft',
                  ]}
                  aria-current={isActive(item) ? 'page' : undefined}
                >
                  {item.label}
                  {isActive(item) && (
                    <span class="absolute bottom-0 left-0 h-[2.5px] w-full rounded-full bg-magenta" />
                  )}
                </a>
              ) : (
                <details data-nav-dropdown class="group">
                  <summary
                    class:list={[
                      'flex items-center gap-1.5 cursor-pointer list-none py-2.5 font-semibold transition-colors duration-200 hover:text-magenta',
                      isActive(item) ? 'text-magenta font-bold' : 'text-ink-soft',
                    ]}
                  >
                    <span>{item.label}</span>
                    <svg
                      class="h-3.5 w-3.5 transition-transform duration-200 group-open:rotate-180 opacity-70"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </summary>
                  <ul class="absolute start-0 z-50 mt-1 min-w-64 rounded-2xl bg-paper-card p-2 shadow-xl ring-1 ring-black/5 animate-in fade-in slide-in-from-top-2 duration-150">
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          class:list={[
                            'block rounded-xl px-3.5 py-2 text-sm font-medium transition-colors hover:bg-paper-shade hover:text-magenta',
                            path === child.path ? 'bg-paper-shade font-semibold text-magenta' : 'text-ink-soft',
                          ]}
                          aria-current={path === child.path ? 'page' : undefined}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Header Actions (Language switcher + CTA button) -->
    <div class="hidden sm:flex items-center gap-4">
      <div class="flex items-center gap-1.5 rounded-full bg-paper-shade px-3 py-1 text-xs font-bold tracking-wide text-ink-soft border border-rule">
        <span class={lang === 'en' ? 'text-magenta' : ''} aria-current={lang === 'en' ? 'true' : undefined}>
          EN
        </span>
        <span class="text-rule-strong" aria-hidden="true">/</span>
        <a
          href={switchLangPath(Astro.url.pathname, other)}
          hreflang={other}
          lang={other}
          rel="alternate"
          class:list={['hover:text-magenta transition-colors', lang === 'ms' ? 'text-magenta' : '']}
          title={t('site.switchTo')}
        >
          BM
        </a>
      </div>

      <!-- Fellowship Church Style Pill CTA -->
      <a
        href={localePath(lang, 'mass-schedule')}
        class="btn-action btn-primary !py-2 !px-5 !text-xs"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>{t('home.ctaMass')}</span>
      </a>
    </div>

    <!-- Mobile Hamburger Toggle -->
    <div class="flex items-center gap-3 lg:hidden">
      <div class="flex items-center gap-1 rounded-full bg-paper-shade px-2.5 py-1 text-xs font-bold border border-rule sm:hidden">
        <a
          href={switchLangPath(Astro.url.pathname, other)}
          class="text-magenta font-semibold"
        >
          {languageShort[other]}
        </a>
      </div>

      <details class="lg:hidden relative" data-mobile-menu>
        <summary
          class="cursor-pointer list-none rounded-full p-2.5 text-ink hover:bg-paper-shade transition-colors"
          aria-label={t('site.menu')}
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </summary>

        <nav
          class="absolute end-0 top-full mt-3 w-80 max-h-[calc(100dvh-5rem)] overflow-y-auto rounded-3xl border border-rule bg-paper-card p-5 shadow-2xl z-50"
          aria-label={t('site.menu')}
        >
          <div class="mb-4 pb-3 border-b border-rule flex items-center justify-between">
            <span class="font-heading text-sm font-bold uppercase tracking-wider text-ink-muted">
              {t('site.menu')}
            </span>
            <a
              href={localePath(lang, 'mass-schedule')}
              class="btn-action btn-primary !py-1.5 !px-3.5 !text-[11px]"
            >
              {t('home.ctaMass')}
            </a>
          </div>

          <ul class="space-y-1">
            {
              items.map((item) => (
                <li class="py-1">
                  <a
                    href={item.href}
                    class:list={[
                      'block rounded-xl px-3 py-2 text-base font-semibold transition-colors',
                      isActive(item) ? 'bg-magenta/10 text-magenta' : 'text-ink hover:bg-paper-shade',
                    ]}
                  >
                    {item.label}
                  </a>
                  {item.children.length > 0 && (
                    <ul class="mt-1 ms-3 space-y-1 border-s-2 border-rule/80 ps-2 text-sm text-ink-soft">
                      {item.children.map((child) => (
                        <li>
                          <a
                            href={child.href}
                            class="block rounded-lg px-2 py-1.5 hover:text-magenta hover:bg-paper-shade"
                          >
                            {child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>

  <!-- Liturgical Season ribbon banner -->
  <div class="h-[3px] bg-gradient-to-r from-gold via-magenta to-purple"></div>
  <div class="bg-paper-shade/80 py-1 px-gutter text-center text-[11px] font-bold tracking-wider uppercase text-ink-soft border-b border-rule/40">
    <span class="inline-block w-2 h-2 rounded-full mr-1.5" style="background-color: var(--season);"></span>
    {season.name[lang]} • Most Holy Redeemer Church & CUTES
  </div>
</header>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
  summary::marker {
    content: '';
  }
</style>

<script>
  // Progressive enhancement only. Without this the menus still open and close
  // by click, they just do not close when you look away.
  const closeAll = (except?: Element) => {
    document
      .querySelectorAll<HTMLDetailsElement>('[data-nav-dropdown][open], [data-mobile-menu][open]')
      .forEach((el) => {
        if (el !== except) el.open = false;
      });
  };

  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    closeAll(target?.closest('[data-nav-dropdown], [data-mobile-menu]') ?? undefined);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const open = document.querySelector<HTMLDetailsElement>(
      '[data-nav-dropdown][open], [data-mobile-menu][open]',
    );
    if (!open) return;
    open.open = false;
    open.querySelector('summary')?.focus();
  });
</script>
