---
import PageHeader from '../components/PageHeader.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { formatDate } from '../i18n/utils';
import BaseLayout from './BaseLayout.astro';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  lang: Lang;
  title: string;
  summary: string;
  path: string;
  note?: string;
  crumbs?: Crumb[];
  updated?: Date;
  accent?: 'season' | 'cutes';
  /** Prayers get a narrower measure, larger type and a print button. */
  variant?: 'page' | 'prayer';
  image?: string;
}

const {
  lang,
  title,
  summary,
  path,
  note,
  crumbs = [],
  updated,
  accent = 'season',
  variant = 'page',
  image,
} = Astro.props;

const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={title} description={summary} path={path} type="article" image={image}>
  <PageHeader
    lang={lang}
    title={title}
    lead={summary}
    note={note}
    crumbs={crumbs}
    accent={accent}
  />

  <div class="mx-auto max-w-[80rem] px-gutter pb-16">
    <div class:list={['reading border-t border-rule pt-10', variant === 'prayer' && 'prayer']}>
      <slot />
    </div>

    <div
      class:list={[
        'mt-14 flex flex-wrap items-center justify-between gap-4 border-t border-rule pt-5 text-[0.875rem] text-ink-soft',
        variant === 'prayer' ? 'max-w-[44ch]' : 'max-w-[63ch]',
      ]}
    >
      {
        updated ? (
          <p>
            {t('common.updated')}{' '}
            <time datetime={updated.toISOString()}>{formatDate(updated, lang)}</time>
          </p>
        ) : (
          <span />
        )
      }

      {
        variant === 'prayer' && (
          <button
            type="button"
            data-print-button
            data-print="hide"
            hidden
            class="link cursor-pointer text-ink"
          >
            {t('resources.print')}
          </button>
        )
      }
    </div>

    <slot name="after" />
  </div>
</BaseLayout>

<script>
  // The print stylesheet does the work; this is only the affordance, and it
  // stays hidden without JavaScript because a dead button is worse than none.
  document.querySelectorAll<HTMLButtonElement>('[data-print-button]').forEach((button) => {
    button.hidden = false;
    button.addEventListener('click', () => window.print());
  });
</script>
