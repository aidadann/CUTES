---
// Weight axis only. The width axis is another 50KB on the first load of every
// page, and this site is read on phones over campus wifi. Archivo is not in
// the type stack any more, so it is not shipped.
import '@fontsource-variable/source-serif-4/wght.css';
import '../styles/global.css';

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Seo from '../components/Seo.astro';
import { site } from '../data/site';
import { useTranslations, type Lang } from '../i18n/ui';
import { assetPath, htmlLang } from '../i18n/utils';
import { liturgicalDay } from '../lib/liturgical';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Path below the language segment, e.g. "gallery/retreat". */
  path: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  lang,
  title,
  description = site.parishName,
  path,
  image,
  type = 'website',
  noindex = false,
} = Astro.props;

const t = useTranslations(lang);

// The whole site's accent colour, decided by the church calendar rather than
// by a brand guideline. Set once, here, on <html>.
const today = liturgicalDay();

const themeColour = { violet: '#5b2b8a', white: '#7a5a12', red: '#a8161c', green: '#14603c' }[
  today.colour
];
---

<!doctype html>
<html lang={htmlLang[lang]} data-season={today.colour}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={assetPath('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={assetPath('logo.jpg')} />
    <meta name="theme-color" content={themeColour} />
    <script is:inline>
      // Set before first paint. Every "hidden until revealed" rule is gated on
      // this class, so a blocked or failed script leaves the page readable
      // rather than blank.
      document.documentElement.classList.add('js');
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap"
      rel="stylesheet"
    />
    <Seo
      lang={lang}
      title={title}
      description={description}
      path={path}
      image={image}
      type={type}
      noindex={noindex}
    />
  </head>

  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only bg-ink px-4 py-2 text-sm font-semibold text-paper focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-50"
    >
      {t('site.skip')}
    </a>

    <Header lang={lang} path={path} season={today} />

    <main id="main" class="grow">
      <slot />
    </main>

    <Footer lang={lang} />

    <script>
      // Entrance observer. Elements stay visible by default (see the .js gate
      // in global.css); this only plays them in when they arrive.
      const reveals = document.querySelectorAll<HTMLElement>('.reveal-on-scroll, .reveal-image');

      // Siblings that arrive together read as a list, so they cascade. The
      // delay is capped: a long row must not keep the reader waiting.
      document.querySelectorAll<HTMLElement>('[data-stagger]').forEach((group) => {
        [...group.children].forEach((child, i) => {
          if (child instanceof HTMLElement && child.classList.contains('reveal-on-scroll')) {
            child.style.setProperty('--reveal-index', String(Math.min(i, 5)));
          }
        });
      });

      const scrollObserver = new IntersectionObserver(
        (entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        },
        { root: null, rootMargin: '0px 0px -12% 0px', threshold: 0.05 },
      );

      reveals.forEach((el) => scrollObserver.observe(el));

      // Header state: flat against the hero, lifted once the page moves under
      // it. Read in a rAF so the scroll listener never touches layout.
      const header = document.querySelector<HTMLElement>('[data-site-header]');
      if (header) {
        let ticking = false;
        const sync = () => {
          header.toggleAttribute('data-scrolled', window.scrollY > 12);
          ticking = false;
        };
        addEventListener(
          'scroll',
          () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(sync);
          },
          { passive: true },
        );
        sync();
      }
    </script>
  </body>
</html>
