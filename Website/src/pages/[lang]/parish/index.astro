---
import PageHeader from '../../../components/PageHeader.astro';
import { useTranslations, type Lang } from '../../../i18n/ui';
import { localeParams, localePath } from '../../../i18n/utils';
import { localized, slugOf } from '../../../lib/content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export const getStaticPaths = localeParams;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const pages = (await localized('pages', lang)).filter((entry) => entry.data.section === 'parish');

// The bulletin and the schedule are not prose pages, so they are added by
// hand to keep this index complete.
const entries = [
  { title: t('nav.bulletin'), summary: t('bulletin.lead'), href: localePath(lang, 'bulletin') },
  {
    title: t('nav.massSchedule'),
    summary: t('home.scheduleLead'),
    href: localePath(lang, 'mass-schedule'),
  },
  ...pages.map((entry) => ({
    title: entry.data.title,
    summary: entry.data.summary,
    href: localePath(lang, `parish/${slugOf(entry.id)}`),
  })),
];
---

<BaseLayout lang={lang} title={t('parish.title')} description={t('parish.lead')} path="parish">
  <PageHeader lang={lang} title={t('parish.title')} lead={t('parish.lead')} />

  <div class="mx-auto max-w-[80rem] px-gutter pb-16">
    <ul class="border-t border-ink">
      {
        entries.map((entry) => (
          <li class="border-b border-rule">
            <a href={entry.href} class="grid gap-x-10 gap-y-1 py-6 no-underline sm:grid-cols-[18rem_1fr]">
              <h2 class="text-xl font-semibold sm:text-2xl">{entry.title}</h2>
              <p class="max-w-[58ch] font-serif text-ink-soft">{entry.summary}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
