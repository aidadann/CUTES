---
import PageHeader from '../../../components/PageHeader.astro';
import { useTranslations, type Lang } from '../../../i18n/ui';
import { localeParams, localePath } from '../../../i18n/utils';
import { localized, slugOf } from '../../../lib/content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export const getStaticPaths = localeParams;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const pages = (await localized('pages', lang)).filter((entry) => entry.data.section === 'parish');

// The two pages that are not prose live outside the `pages` collection, so
// they are added here by hand to keep this index complete.
const cards = [
  {
    title: t('nav.bulletin'),
    summary: t('bulletin.lead'),
    href: localePath(lang, 'bulletin'),
  },
  {
    title: t('nav.massSchedule'),
    summary: t('home.scheduleLead'),
    href: localePath(lang, 'mass-schedule'),
  },
  ...pages.map((entry) => ({
    title: entry.data.title,
    summary: entry.data.summary,
    href: localePath(lang, `parish/${slugOf(entry.id)}`),
  })),
];
---

<BaseLayout lang={lang} title={t('parish.title')} description={t('parish.lead')} path="parish">
  <PageHeader lang={lang} title={t('parish.title')} lead={t('parish.lead')} crumbs={[]} />

  <div class="mx-auto max-w-6xl px-gutter py-12">
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        cards.map((card) => (
          <li>
            <a
              href={card.href}
              class="group flex h-full flex-col rounded-card border border-line bg-surface-raised p-6 transition-shadow hover:shadow-md"
            >
              <span class="block h-2.5 w-2.5 rotate-45 bg-brand-gold" aria-hidden="true" />
              <h2 class="mt-4 font-display text-xl font-semibold group-hover:text-accent">
                {card.title}
              </h2>
              <p class="mt-2 text-sm text-content-muted">{card.summary}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
