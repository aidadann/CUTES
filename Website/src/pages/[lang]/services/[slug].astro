---
import { render } from 'astro:content';

import { site } from '../../../data/site';
import { languages, useTranslations, type Lang } from '../../../i18n/ui';
import { localePath } from '../../../i18n/utils';
import { localizedPaths } from '../../../lib/content';
import ProseLayout from '../../../layouts/ProseLayout.astro';

export async function getStaticPaths() {
  return localizedPaths('services', Object.keys(languages) as Lang[]);
}

const { entry } = Astro.props;
const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug as string;
const t = useTranslations(lang);
const { Content } = await render(entry);
---

<ProseLayout
  lang={lang}
  title={entry.data.title}
  summary={entry.data.summary}
  path={`services/${slug}`}
  note={entry.data.noticePeriod}
  crumbs={[{ label: t('services.title'), href: localePath(lang, 'services') }]}
  updated={entry.data.updated}
>
  {
    entry.data.requirements && entry.data.requirements.length > 0 && (
      /* What to bring, before the explanation of why. Someone who opens this
         page has usually already decided; they need the list. */
      <aside class="mb-10 border-t-[3px] border-ink pt-5 font-sans">
        <h2 class="text-base font-semibold">{t('services.requirements')}</h2>
        <ul class="mt-3 max-w-[52ch] list-none ps-0">
          {entry.data.requirements.map((requirement) => (
            <li class="border-b border-rule py-2.5 text-[0.9375rem]">{requirement}</li>
          ))}
        </ul>
      </aside>
    )
  }

  <Content />

  <aside slot="after" class="mt-14 max-w-[52ch] border-t border-rule pt-6">
    <h2 class="text-base font-semibold">{t('services.contactHeading')}</h2>
    <p class="mt-2 text-ink-soft">{entry.data.contact ?? t('services.contactFallback')}</p>
    <p class="mt-3">
      <a href={`mailto:${site.email}`} class="link">{site.email}</a><br />
      <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="link tabular">{site.phoneDisplay}</a>
    </p>
    <p class="mt-3">
      <a href={localePath(lang, 'contact')} class="link">{t('contact.title')}</a>
    </p>
  </aside>
</ProseLayout>
