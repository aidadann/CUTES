---
import { render } from 'astro:content';

import { site } from '../../../data/site';
import { languages, useTranslations, type Lang } from '../../../i18n/ui';
import { localePath } from '../../../i18n/utils';
import { localizedPaths } from '../../../lib/content';
import ProseLayout from '../../../layouts/ProseLayout.astro';

export async function getStaticPaths() {
  return localizedPaths('services', Object.keys(languages) as Lang[]);
}

const { entry } = Astro.props;
const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug as string;
const t = useTranslations(lang);
const { Content } = await render(entry);
---

<ProseLayout
  lang={lang}
  title={entry.data.title}
  summary={entry.data.summary}
  path={`services/${slug}`}
  kicker={entry.data.noticePeriod}
  crumbs={[{ label: t('services.title'), href: localePath(lang, 'services') }]}
  updated={entry.data.updated}
>
  {
    entry.data.requirements && entry.data.requirements.length > 0 && (
      <aside class="not-prose mb-8 rounded-card border border-line bg-surface-sunken p-5">
        <h2 class="font-display text-base font-semibold">{t('services.requirements')}</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {entry.data.requirements.map((requirement) => (
            <li class="flex gap-2.5">
              <span class="mt-1.5 block h-1.5 w-1.5 shrink-0 rotate-45 bg-brand-gold" aria-hidden="true" />
              <span>{requirement}</span>
            </li>
          ))}
        </ul>
      </aside>
    )
  }

  <Content />

  <aside slot="after" class="mx-auto mt-10 max-w-[68ch] rounded-card border border-line bg-surface-sunken p-5 text-sm">
    <h2 class="font-display text-base font-semibold">{t('services.contactHeading')}</h2>
    <p class="mt-2 text-content-muted">{entry.data.contact ?? t('services.contactFallback')}</p>
    <p class="mt-3">
      <a href={`mailto:${site.email}`} class="font-medium hover:underline">{site.email}</a>
      <span class="text-content-muted"> &middot; </span>
      <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="font-medium hover:underline">
        {site.phoneDisplay}
      </a>
    </p>
    <p class="mt-3">
      <a href={localePath(lang, 'contact')} class="font-medium text-accent hover:underline">
        {t('contact.title')} &rarr;
      </a>
    </p>
  </aside>
</ProseLayout>
