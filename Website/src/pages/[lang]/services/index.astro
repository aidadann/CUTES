---
import PageHeader from '../../../components/PageHeader.astro';
import { site } from '../../../data/site';
import { useTranslations, type Lang } from '../../../i18n/ui';
import { localeParams, localePath } from '../../../i18n/utils';
import { localized, slugOf } from '../../../lib/content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export const getStaticPaths = localeParams;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const services = await localized('services', lang);
---

<BaseLayout lang={lang} title={t('services.title')} description={t('services.lead')} path="services">
  <PageHeader lang={lang} title={t('services.title')} lead={t('services.lead')} />

  <div class="mx-auto max-w-[80rem] px-gutter pb-16">
    <ul class="border-t border-ink">
      {
        services.map((entry) => (
          <li class="border-b border-rule">
            <a
              href={localePath(lang, `services/${slugOf(entry.id)}`)}
              class="grid gap-x-10 gap-y-1 py-6 no-underline sm:grid-cols-[18rem_1fr]"
            >
              <div>
                <h2 class="text-xl font-semibold sm:text-2xl">{entry.data.title}</h2>
                {/* How much notice the parish needs is the single most useful
                    fact on this page, so it sits with the title. */}
                {entry.data.noticePeriod && (
                  <p class="mt-1 text-[0.9375rem]" style="color: var(--season-ink)">
                    {entry.data.noticePeriod}
                  </p>
                )}
              </div>
              <p class="max-w-[58ch] font-serif text-ink-soft">{entry.data.summary}</p>
            </a>
          </li>
        ))
      }
    </ul>

    <aside class="mt-10 max-w-[52ch] text-ink-soft">
      <p>{t('services.contactFallback')}</p>
      <p class="mt-2">
        <a href={`mailto:${site.email}`} class="link text-ink">{site.email}</a><br />
        <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="link tabular text-ink">
          {site.phoneDisplay}
        </a>
      </p>
    </aside>
  </div>
</BaseLayout>
