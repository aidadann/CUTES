---
import PageHeader from '../../../components/PageHeader.astro';
import { useTranslations, type Lang, type UiKey } from '../../../i18n/ui';
import { localeParams, localePath } from '../../../i18n/utils';
import { localized, slugOf } from '../../../lib/content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export const getStaticPaths = localeParams;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const resources = await localized('resources', lang);
const categories = ['prayer', 'devotion', 'other'] as const;

const grouped = categories
  .map((category) => ({
    category,
    heading: t(`resources.category.${category}` as UiKey),
    entries: resources.filter((entry) => entry.data.category === category),
  }))
  .filter((group) => group.entries.length > 0);
---

<BaseLayout
  lang={lang}
  title={t('resources.title')}
  description={t('resources.lead')}
  path="resources"
>
  <PageHeader lang={lang} title={t('resources.title')} lead={t('resources.lead')} />

  <div class="mx-auto max-w-4xl px-gutter py-12">
    {
      grouped.map((group) => (
        <section class="mb-12">
          <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-gold-ink">
            {group.heading}
          </h2>
          <ul class="mt-4 grid gap-4 sm:grid-cols-2">
            {group.entries.map((entry) => (
              <li>
                <a
                  href={localePath(lang, `resources/${slugOf(entry.id)}`)}
                  class="group flex h-full flex-col rounded-card border border-line bg-surface-raised p-5 transition-shadow hover:shadow-md"
                >
                  <h3 class="font-display text-lg font-semibold group-hover:text-accent">
                    {entry.data.title}
                  </h3>
                  <p class="mt-1.5 text-sm text-content-muted">{entry.data.summary}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
