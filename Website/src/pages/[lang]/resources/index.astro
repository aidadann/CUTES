---
import PageHeader from '../../../components/PageHeader.astro';
import { useTranslations, type Lang, type UiKey } from '../../../i18n/ui';
import { localeParams, localePath } from '../../../i18n/utils';
import { localized, slugOf } from '../../../lib/content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export const getStaticPaths = localeParams;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const resources = await localized('resources', lang);
const categories = ['prayer', 'devotion', 'other'] as const;

const grouped = categories
  .map((category) => ({
    heading: t(`resources.category.${category}` as UiKey),
    entries: resources.filter((entry) => entry.data.category === category),
  }))
  .filter((group) => group.entries.length > 0);
---

<BaseLayout
  lang={lang}
  title={t('resources.title')}
  description={t('resources.lead')}
  path="resources"
>
  <PageHeader lang={lang} title={t('resources.title')} lead={t('resources.lead')} />

  <div class="mx-auto max-w-[80rem] px-gutter pb-16">
    {
      grouped.map((group) => (
        <section class="mb-14">
          <h2 class="text-xl font-semibold">{group.heading}</h2>
          <ul class="mt-4 border-t border-ink">
            {group.entries.map((entry) => (
              <li class="border-b border-rule">
                <a
                  href={localePath(lang, `resources/${slugOf(entry.id)}`)}
                  class="grid gap-x-10 gap-y-1 py-6 no-underline sm:grid-cols-[18rem_1fr]"
                >
                  <h3 class="text-xl font-semibold sm:text-2xl">{entry.data.title}</h3>
                  <p class="max-w-[58ch] font-serif text-ink-soft">{entry.data.summary}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
