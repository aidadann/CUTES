---
import PageHeader from '../../components/PageHeader.astro';
import { useTranslations, type Lang } from '../../i18n/ui';
import { assetPath, formatDate, localeParams, localePath } from '../../i18n/utils';
import { listBulletins } from '../../lib/bulletin';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = localeParams;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const bulletins = listBulletins();
const [latest, ...archive] = bulletins;
---

<BaseLayout lang={lang} title={t('bulletin.title')} description={t('bulletin.lead')} path="bulletin">
  <PageHeader
    lang={lang}
    title={t('bulletin.title')}
    lead={t('bulletin.lead')}
    crumbs={[{ label: t('nav.parish'), href: localePath(lang, 'parish') }]}
  />

  <div class="mx-auto max-w-[80rem] px-gutter pb-16">
    {
      bulletins.length === 0 ? (
        <p class="max-w-[52ch] border-t border-rule pt-6 font-serif text-lg text-ink-soft">
          {t('bulletin.empty')}
        </p>
      ) : (
        <>
          {/* The current bulletin is the page's reason to exist, so it is set
              at the size of a headline rather than filed as the first row of
              a list. */}
          <a
            href={assetPath(latest!.href)}
            class="block border-t-[3px] border-ink pt-6 no-underline"
          >
            <p class="text-[0.9375rem] font-semibold" style="color: var(--season-ink)">
              {t('bulletin.thisWeek')}
            </p>
            <p class="mt-2 text-[clamp(2rem,1.4rem+2.6vw,3.25rem)] font-semibold">
              <time datetime={latest!.iso}>{formatDate(latest!.date, lang)}</time>
            </p>
            <p class="link mt-3 inline-block text-[0.9375rem]">{t('bulletin.download')}</p>
          </a>

          {archive.length > 0 && (
            <section class="mt-16">
              <h2 class="text-xl font-semibold">{t('bulletin.archive')}</h2>
              <ul class="mt-4 max-w-[40rem] border-t border-rule">
                {archive.map((bulletin) => (
                  <li>
                    <a
                      href={assetPath(bulletin.href)}
                      class="flex items-baseline justify-between gap-4 border-b border-rule py-3.5 no-underline hover:underline"
                      aria-label={`${t('bulletin.open')} ${formatDate(bulletin.date, lang)}`}
                    >
                      <time datetime={bulletin.iso}>{formatDate(bulletin.date, lang)}</time>
                      <span class="text-sm text-ink-soft">PDF</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}

          <p class="mt-8 text-[0.875rem] text-ink-soft">{t('bulletin.pdfNote')}</p>
        </>
      )
    }
  </div>
</BaseLayout>
