---
import PageHeader from '../../components/PageHeader.astro';
import { useTranslations, type Lang } from '../../i18n/ui';
import { assetPath, formatDate, localeParams, localePath } from '../../i18n/utils';
import { listBulletins } from '../../lib/bulletin';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = localeParams;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const bulletins = listBulletins();
const [latest, ...archive] = bulletins;
---

<BaseLayout lang={lang} title={t('bulletin.title')} description={t('bulletin.lead')} path="bulletin">
  <PageHeader
    lang={lang}
    title={t('bulletin.title')}
    lead={t('bulletin.lead')}
    crumbs={[{ label: t('nav.parish'), href: localePath(lang, 'parish') }]}
  />

  <div class="mx-auto max-w-3xl px-gutter py-12">
    {
      bulletins.length === 0 ? (
        <p class="rounded-card border border-dashed border-line-strong px-5 py-12 text-center text-content-muted">
          {t('bulletin.empty')}
        </p>
      ) : (
        <>
          <a
            href={assetPath(latest!.href)}
            class="group block rounded-card border border-line bg-surface-raised p-6 transition-shadow hover:shadow-md sm:p-8"
          >
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent-cutes">
              {t('bulletin.thisWeek')}
            </p>
            <p class="mt-2 font-display text-2xl font-semibold group-hover:text-accent sm:text-3xl">
              <time datetime={latest!.iso}>{formatDate(latest!.date, lang)}</time>
            </p>
            <p class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-accent">
              {t('bulletin.download')}
              <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path
                  d="M8 2v9m0 0 3.5-3.5M8 11 4.5 7.5M2.5 13.5h11"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </p>
          </a>

          {archive.length > 0 && (
            <section class="mt-12">
              <h2 class="font-display text-lg font-semibold">{t('bulletin.archive')}</h2>
              <ul class="mt-4 divide-y divide-line border-y border-line">
                {archive.map((bulletin) => (
                  <li>
                    <a
                      href={assetPath(bulletin.href)}
                      class="link-quiet flex items-center justify-between gap-4 py-3.5 text-sm transition-colors hover:text-accent"
                      aria-label={`${t('bulletin.open')} ${formatDate(bulletin.date, lang)}`}
                    >
                      <time datetime={bulletin.iso} class="font-medium">
                        {formatDate(bulletin.date, lang)}
                      </time>
                      <span class="text-xs uppercase tracking-wide text-content-muted">PDF</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}

          <p class="mt-8 text-xs text-content-muted">{t('bulletin.pdfNote')}</p>
        </>
      )
    }
  </div>
</BaseLayout>
