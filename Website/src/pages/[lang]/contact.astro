---
import MassScheduleTable from '../../components/MassScheduleTable.astro';
import PageHeader from '../../components/PageHeader.astro';
import { site } from '../../data/site';
import { useTranslations, type Lang } from '../../i18n/ui';
import { localeParams } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = localeParams;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const socials = Object.entries(site.social).filter(([, url]) => url !== '');
const tel = site.phone.replace(/\s/g, '');
---

<BaseLayout lang={lang} title={t('contact.title')} description={t('contact.lead')} path="contact">
  <PageHeader lang={lang} title={t('contact.title')} lead={t('contact.lead')} />

  <div class="mx-auto max-w-[80rem] px-gutter pb-16">
    <div class="grid gap-12 border-t border-ink pt-8 lg:grid-cols-2 lg:gap-16">
      <div>
        <address class="not-italic">
          <p class="text-[clamp(1.5rem,1.2rem+1.2vw,2.25rem)] font-semibold leading-tight">
            {site.address.line2}<br />
            <span class="tabular">{site.address.postcode}</span>
            {site.address.city}
          </p>
          <p class="mt-2 text-ink-soft">{site.address.state}, {site.address.country}</p>
        </address>

        <p class="mt-8">
          <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer" class="button">
            {t('contact.openMaps')}
          </a>
        </p>

        <dl class="mt-10 border-t border-rule">
          <div class="flex flex-wrap gap-x-6 border-b border-rule py-3.5">
            <dt class="w-32 shrink-0 text-ink-soft">{t('contact.email')}</dt>
            <dd><a href={`mailto:${site.email}`} class="link">{site.email}</a></dd>
          </div>
          <div class="flex flex-wrap gap-x-6 border-b border-rule py-3.5">
            <dt class="w-32 shrink-0 text-ink-soft">{t('contact.phone')}</dt>
            <dd><a href={`tel:${tel}`} class="link tabular">{site.phoneDisplay}</a></dd>
          </div>
          <div class="flex flex-wrap gap-x-6 border-b border-rule py-3.5">
            <dt class="w-32 shrink-0 text-ink-soft">{t('contact.hours')}</dt>
            <dd class="max-w-[32ch]">{t('contact.hoursValue')}</dd>
          </div>
          {
            socials.length > 0 && (
              <div class="flex flex-wrap gap-x-6 border-b border-rule py-3.5">
                <dt class="w-32 shrink-0 text-ink-soft">{t('contact.follow')}</dt>
                <dd class="flex gap-5">
                  {socials.map(([name, url]) => (
                    <a href={url} target="_blank" rel="noopener noreferrer" class="link capitalize">
                      {name}
                    </a>
                  ))}
                </dd>
              </div>
            )
          }
        </dl>

        <section class="mt-12" style="border-top: 3px solid var(--color-cutes)">
          <h2 class="mt-5 text-xl font-semibold">{t('contact.cutesHeading')}</h2>
          <p class="mt-1.5 max-w-[48ch] font-serif text-ink-soft">{t('contact.cutesLead')}</p>
          <p class="mt-3">
            <a href={`mailto:${site.cutesEmail}`} class="link">{site.cutesEmail}</a>
          </p>
        </section>
      </div>

      <div>
        <h2 class="text-xl font-semibold">{t('schedule.title')}</h2>
        <div class="mt-4">
          <MassScheduleTable lang={lang} highlightOnly />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
