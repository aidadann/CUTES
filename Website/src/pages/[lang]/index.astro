            Serving Tanjung Malim through seven ministries: Liturgy, Choir, Music, Multimedia, Transportation, Recreation & Spiritual, and Entrepreneurship. Everyone has a gift to share.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-rule/60">
          <a href={localePath(lang, 'cutes/committee')} class="text-xs font-bold text-purple hover:text-magenta transition-colors inline-flex items-center gap-1">
            <span>Meet the Ministries</span> &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. CUTES YOUTH SPOTLIGHT BANNER (Rich Gradient Banner inspired by Fellowship) -->
  <section class="relative overflow-hidden bg-gradient-to-r from-purple-dark via-purple to-magenta text-white py-20 sm:py-28 my-8">
    <div class="mx-auto max-w-[84rem] px-gutter relative z-10">
      <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr] items-center">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full bg-gold/20 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-gold border border-gold/40">
            <span>UPSI Tertiary Catholic Community</span>
          </div>
          <h2 class="mt-5 font-heading text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-tight">
            {site.communityFullName}
          </h2>
          <p class="mt-6 max-w-[54ch] text-base sm:text-lg leading-relaxed text-white/85">
            {t('home.cutesLead')} Join our weekly fellowships, praise and worship, exam retreats, and vibrant parish celebrations.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href={localePath(lang, 'cutes')} class="btn-action btn-gold">
              <span>{t('home.cutesCta')}</span>
            </a>
            <a href={localePath(lang, 'cutes/committee')} class="btn-action btn-white">
              <span>{t('nav.committee')}</span>
            </a>
          </div>
        </div>

        <!-- Right Quick Statistics / Identity Cards -->
        <div class="grid grid-cols-2 gap-4">
          <div class="rounded-2xl bg-white/10 p-5 backdrop-blur-md border border-white/20">
            <div class="text-3xl font-extrabold font-heading text-gold">7+</div>
            <p class="mt-1 text-xs font-bold uppercase tracking-wider text-white/75">Active Ministries</p>
            <p class="mt-2 text-xs text-white/70">Choir, Liturgy, Transport, Media & more.</p>
          </div>
          <div class="rounded-2xl bg-white/10 p-5 backdrop-blur-md border border-white/20">
            <div class="text-3xl font-extrabold font-heading text-gold">UPSI</div>
            <p class="mt-1 text-xs font-bold uppercase tracking-wider text-white/75">Student Home</p>
            <p class="mt-2 text-xs text-white/70">Transportation provided from campus hostels.</p>
          </div>
          <div class="rounded-2xl bg-white/10 p-5 backdrop-blur-md border border-white/20">
            <div class="text-3xl font-extrabold font-heading text-gold">Weekly</div>
            <p class="mt-1 text-xs font-bold uppercase tracking-wider text-white/75">Mass & Fellowship</p>
            <p class="mt-2 text-xs text-white/70">Sunday gatherings and shared meals after Mass.</p>
          </div>
          <div class="rounded-2xl bg-white/10 p-5 backdrop-blur-md border border-white/20">
            <div class="text-3xl font-extrabold font-heading text-gold">BEC</div>
            <p class="mt-1 text-xs font-bold uppercase tracking-wider text-white/75">Basic Ecclesial</p>
            <p class="mt-2 text-xs text-white/70">Small group prayer & neighborhood connection.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. UPCOMING EVENTS & BULLETIN SECTION -->
  <section class="mx-auto max-w-[84rem] px-gutter py-20">
    <div class="flex flex-wrap items-end justify-between gap-4 pb-8 border-b border-rule">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-purple">Calendar & Community</span>
        <h2 class="mt-1 font-heading text-3xl sm:text-4xl font-extrabold text-ink">
          {t('home.eventsTitle')}
        </h2>
      </div>
      <a href={localePath(lang, 'events')} class="btn-action btn-secondary !py-2 !px-4 !text-xs">
        <span>{t('home.eventsAll')}</span> &rarr;
      </a>
    </div>

    {
      nextEvents.length === 0 ? (
        <div class="mt-10 rounded-2xl border border-rule bg-paper-shade p-8 text-center text-ink-soft">
          <p>{t('home.eventsEmpty')}</p>
        </div>
      ) : (
        <div class="mt-8 grid gap-6 md:grid-cols-3">
          {nextEvents.map((entry) => (
            <article class="church-card flex flex-col justify-between group">
              <div>
                <div class="flex items-center justify-between gap-2 text-xs font-bold text-magenta mb-4">
                  <span class="pill-badge bg-magenta/10 text-magenta">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <span>{formatDateRange(entry.data.startDate, entry.data.endDate, lang)}</span>
                  </span>
                </div>
                <h3 class="font-heading text-xl font-bold text-ink group-hover:text-magenta transition-colors">
                  <a href={localePath(lang, `events/${slugOf(entry.id)}`)}>
                    {entry.data.title}
                  </a>
                </h3>
                <p class="mt-2.5 text-sm text-ink-soft line-clamp-3 leading-relaxed">
                  {entry.data.summary}
                </p>
              </div>

              <div class="mt-6 pt-4 border-t border-rule flex items-center justify-between text-xs text-ink-muted">
                <span class="flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-purple shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span class="truncate max-w-[18ch]">{entry.data.location}</span>
                </span>
                <a href={localePath(lang, `events/${slugOf(entry.id)}`)} class="font-bold text-purple group-hover:text-magenta transition-colors">
                  Details &rarr;
                </a>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </section>

  <!-- 6. VISION & MISSION SECTION -->
  {
    Vision && (
      <section class="bg-paper-shade border-y border-rule py-16 sm:py-24">
        <div class="mx-auto max-w-[84rem] px-gutter">
          <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] items-center">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-purple">Core Foundations</span>
              <h2 class="mt-2 font-heading text-3xl sm:text-4xl font-extrabold text-ink">
                {t('home.visionTitle')}
              </h2>
              <p class="mt-4 text-base text-ink-soft leading-relaxed">
                Guided by the Archdiocese of Kuala Lumpur, our parish fosters communal solidarity, liturgical life, and outreach for university students and parishioners alike.
              </p>
              <div class="mt-6">
                <a href={localePath(lang, 'parish/parish-history')} class="btn-action btn-secondary !py-2.5 !px-5 !text-xs">
                  <span>Read Parish History</span> &rarr;
                </a>
              </div>
            </div>

            <div class="church-card bg-paper-card">
              <div class="reading">
                <Vision />
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- 7. THREE ACTION NAVIGATION BLOCKS (Like Fellowship's bottom 3-column feature) -->
  <section class="mx-auto max-w-[84rem] px-gutter py-20">
    <div class="grid gap-6 sm:grid-cols-3">
      <a
        href={localePath(lang, 'services')}
        class="group relative overflow-hidden rounded-3xl bg-gradient-to-br from-purple to-purple-dark p-8 text-white shadow-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
      >
        <div class="text-xs font-bold uppercase tracking-widest text-gold-light">Parish Services</div>
        <h3 class="mt-3 font-heading text-2xl font-bold text-white group-hover:text-gold transition-colors">
          Sacraments & RCIA
        </h3>
        <p class="mt-2 text-sm text-white/80">
          Baptism, First Holy Communion, Confirmation, Marriage, and pastoral blessings.
        </p>
        <span class="mt-6 inline-flex items-center gap-1.5 text-xs font-bold text-gold uppercase tracking-wider">
          <span>Learn More</span> &rarr;
        </span>
      </a>

      <a
        href={localePath(lang, 'cutes/committee')}
        class="group relative overflow-hidden rounded-3xl bg-gradient-to-br from-magenta to-magenta-hover p-8 text-white shadow-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
      >
        <div class="text-xs font-bold uppercase tracking-widest text-white/80">Student Leadership</div>
        <h3 class="mt-3 font-heading text-2xl font-bold text-white group-hover:text-gold transition-colors">
          Ministries & Roster
        </h3>
        <p class="mt-2 text-sm text-white/80">
          Connect with coordinators and ministry heads across Choir, Liturgy, and Publicity.
        </p>
        <span class="mt-6 inline-flex items-center gap-1.5 text-xs font-bold text-white uppercase tracking-wider">
          <span>Meet the Team</span> &rarr;
        </span>
      </a>

      <a
        href={localePath(lang, 'resources')}
        class="group relative overflow-hidden rounded-3xl bg-gradient-to-br from-zinc-800 to-zinc-950 p-8 text-white shadow-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
      >
        <div class="text-xs font-bold uppercase tracking-widest text-gold">Spiritual Resources</div>
        <h3 class="mt-3 font-heading text-2xl font-bold text-white group-hover:text-gold transition-colors">
          Prayers & Rosary
        </h3>
        <p class="mt-2 text-sm text-white/80">
          Holy Rosary, Divine Mercy Chaplet, Basic Catholic Prayers in English and BM.
        </p>
        <span class="mt-6 inline-flex items-center gap-1.5 text-xs font-bold text-gold uppercase tracking-wider">
          <span>Pray Together</span> &rarr;
        </span>
      </a>
    </div>
  </section>
</BaseLayout>
