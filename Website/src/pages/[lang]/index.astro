---
import { getCollection } from 'astro:content';
import { render } from 'astro:content';

import { site } from '../../data/site';
import { useTranslations, type Lang } from '../../i18n/ui';
import { formatDateRange, localeParams, localePath } from '../../i18n/utils';
import { localized, localizedEntry, slugOf, splitEvents } from '../../lib/content';
import { listBulletins } from '../../lib/bulletin';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = localeParams;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const dayNames: Record<string, { en: string; ms: string }> = {
  monday: { en: 'Monday', ms: 'Isnin' },
  tuesday: { en: 'Tuesday', ms: 'Selasa' },
  wednesday: { en: 'Wednesday', ms: 'Rabu' },
  thursday: { en: 'Thursday', ms: 'Khamis' },
  friday: { en: 'Friday', ms: 'Jumaat' },
  saturday: { en: 'Saturday', ms: 'Sabtu' },
  sunday: { en: 'Sunday', ms: 'Ahad' },
  'first-friday': { en: 'First Friday', ms: 'Jumaat Pertama' },
  weekday: { en: 'Weekdays', ms: 'Hari biasa' },
};

/**
 * "8:30 am" -> { clock: "8:30", meridiem: "am" }, so the digits can be set
 * large and the meridiem small beside them. Times without a meridiem (a
 * 24-hour parish, or a range) pass through whole.
 */
function splitTime(time: string): { clock: string; meridiem: string } {
  const match = /^(.*?)\s*(am|pm|AM|PM)$/.exec(time.trim());
  return match ? { clock: match[1]!, meridiem: match[2]!.toLowerCase() } : { clock: time, meridiem: '' };
}

const vision = await localizedEntry('pages', lang, 'vision-mission');
const { Content: Vision } = vision ? await render(vision) : { Content: null };

const masses = (await getCollection('massTimes'))
  .filter((entry) => entry.data.kind === 'mass')
  .sort((a, b) => a.data.order - b.data.order);

const sunday = masses.filter((entry) => entry.data.day === 'sunday');
const otherMasses = masses.filter((entry) => entry.data.day !== 'sunday');

const { upcoming } = splitEvents(await localized('events', lang));
const nextEvents = upcoming.slice(0, 3);
const latestBulletin = listBulletins()[0];
---

<BaseLayout lang={lang} title={site.parishName} description={t('home.heroLead')} path="">
  <!-- 1. HERO SECTION (Reverse-Engineered from Fellowship Church layout) -->
  <section class="relative overflow-hidden bg-gradient-to-b from-paper via-paper-shade/50 to-paper pb-16 pt-8 sm:pb-24 sm:pt-16">
    <!-- Subtle liturgical ambient glow -->
    <div class="pointer-events-none absolute -top-24 left-1/2 -z-10 h-96 w-[45rem] -translate-x-1/2 rounded-full bg-gradient-to-tr from-gold/15 via-magenta/10 to-purple/15 blur-3xl"></div>

    <div class="mx-auto max-w-[84rem] px-gutter">
      <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
        <!-- Left Column: Editorial Welcome & CTAs -->
        <div>
          <div class="inline-flex items-center gap-2 rounded-full bg-gold/15 px-3.5 py-1.5 text-xs font-bold uppercase tracking-wider text-gold-hover border border-gold/30">
            <span class="h-2 w-2 rounded-full bg-gold animate-pulse"></span>
            <span>{site.diocese} • Tanjung Malim</span>
          </div>

          <h1 class="mt-6 font-heading text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-ink leading-[1.05]">
            A Church for <span class="italic font-serif text-magenta">Real Faith</span> & <span class="bg-gradient-to-r from-purple to-magenta bg-clip-text text-transparent">Community</span>
          </h1>

          <p class="mt-6 max-w-[48ch] text-lg sm:text-xl font-normal leading-relaxed text-ink-soft">
            Welcome to <strong class="font-bold text-ink">{site.parishName}</strong> and <strong class="font-bold text-magenta">CUTES</strong> (Catholic UPSI Students). We make room for every student, parishioner, and seeker to encounter God's living grace.
          </p>

          <!-- Fellowship Church Style Twin Action Buttons -->
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a href={localePath(lang, 'mass-schedule')} class="btn-action btn-primary">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>{t('home.ctaMass')}</span>
            </a>
            <a href={localePath(lang, 'cutes')} class="btn-action btn-purple">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
              <span>{t('home.cutesCta')}</span>
            </a>
            <a href={localePath(lang, 'bulletin')} class="btn-action btn-secondary">
              <svg class="w-4 h-4 text-magenta" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span>{t('home.ctaBulletin')}</span>
            </a>
          </div>

          <!-- Quick Service Location Callout -->
          <div class="mt-8 flex items-center gap-3 pt-6 border-t border-rule text-sm text-ink-soft">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gold/20 text-gold-hover">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <p class="font-semibold text-ink">{site.address.line2}, {site.town}</p>
              <p class="text-xs text-ink-muted">Join us for Sunday Mass • English & Bahasa Malaysia</p>
            </div>
          </div>
        </div>

        <!-- Right Column: Hero Visual Feature (Curved frame with CUTES Identity) -->
        <div class="relative">
          <div class="relative overflow-hidden rounded-[28px] border-2 border-gold/30 bg-paper-card shadow-2xl transition-all duration-300 hover:shadow-gold/10">
            <!-- Top Gradient Visual Frame -->
            <div class="relative h-64 sm:h-80 w-full overflow-hidden bg-gradient-to-br from-purple-dark via-purple to-magenta p-6 flex flex-col justify-between text-white">
              <div class="flex items-center justify-between z-10">
                <span class="pill-badge bg-white/20 backdrop-blur-md text-white border border-white/30">
                  UPSI Tertiary Campus
                </span>
                <img
                  src="/logo.jpg"
                  alt="CUTES Logo"
                  class="h-14 w-14 rounded-full border-2 border-gold shadow-lg object-cover"
                />
              </div>

              <!-- Visual Cross & Community Badge Overlay -->
              <div class="z-10 mt-auto">
                <p class="text-xs font-bold uppercase tracking-widest text-gold-light">
                  Most Holy Redeemer Church
                </p>
                <h3 class="font-heading text-2xl sm:text-3xl font-bold leading-tight text-white">
                  Centered on Christ, Empowered by the Spirit
                </h3>
              </div>

              <!-- Decorative cross & flame watermark -->
              <div class="absolute -right-8 -bottom-10 opacity-15 pointer-events-none">
                <svg class="w-64 h-64 text-white" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M11 2v7H4v4h7v9h4v-9h7V9h-7V2h-4z" />
                </svg>
              </div>
            </div>

            <!-- Bottom Quick Schedule Summary inside Card -->
            <div class="p-6 bg-paper-card">
              <div class="flex items-center justify-between mb-4">
                <h4 class="font-heading text-sm font-bold uppercase tracking-wider text-purple flex items-center gap-2">
                  <svg class="w-4 h-4 text-magenta" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <span>{dayNames.sunday?.[lang]} Celebrations</span>
                </h4>
                <a href={localePath(lang, 'mass-schedule')} class="text-xs font-bold text-magenta hover:underline">
                  {t('home.scheduleAll')} &rarr;
                </a>
              </div>

              <div class="space-y-3">
                {
                  sunday.map((entry) => (
                    <div class="flex items-center justify-between p-3 rounded-xl bg-paper-shade border border-rule/60 hover:border-gold/60 transition-colors">
                      <div class="flex items-center gap-3">
                        <div class="flex items-baseline gap-1 text-ink">
                          <span class="clock text-xl text-purple">
                            {splitTime(entry.data.time).clock}
                          </span>
                          <span class="text-xs font-bold uppercase text-ink-muted">
                            {splitTime(entry.data.time).meridiem}
                          </span>
                        </div>
                        <span class="h-4 w-px bg-rule"></span>
                        <span class="text-sm font-semibold text-ink">
                          {entry.data.language}
                        </span>
                      </div>
                      {entry.data.note && (
                        <span class="text-xs px-2.5 py-0.5 rounded-full bg-gold/15 text-gold-hover font-medium">
                          {entry.data.note[lang]}
                        </span>
                      )}
                    </div>
                  ))
                }
              </div>

              <!-- Other masses & latest bulletin footer inside hero card -->
              <div class="mt-4 pt-3 border-t border-rule/60 flex flex-wrap items-center justify-between gap-2 text-xs text-ink-soft">
                <div class="flex items-center gap-2">
                  <span class="font-bold text-ink">Weekday:</span>
                  {otherMasses.slice(0, 1).map((m) => (
                    <span>{m.data.time} ({dayNames[m.data.day]?.[lang] ?? m.data.day})</span>
                  ))}
                </div>
                {latestBulletin && (
                  <a href={localePath(lang, 'bulletin')} class="font-semibold text-magenta hover:underline">
                    {t('bulletin.thisWeek')}: {latestBulletin.iso}
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. INFINITE MARQUEE BAND (Signature Fellowship Church element) -->
  <section class="bg-gradient-to-r from-purple-dark via-purple to-magenta py-4 text-white shadow-inner overflow-hidden border-y border-gold/30" aria-hidden="true">
    <div class="marquee-band">
      <div class="marquee-track">
        <span class="font-heading font-bold uppercase tracking-widest text-sm flex items-center gap-3">
          <span>MOST HOLY REDEEMER CHURCH</span>
          <span class="text-gold">•</span>
          <span>CUTES STUDENT FELLOWSHIP</span>
          <span class="text-gold">•</span>
          <span>UPSI TANJUNG MALIM</span>
          <span class="text-gold">•</span>
          <span>FAITH, HOPE & CHARITY</span>
          <span class="text-gold">•</span>
          <span>ALL ARE WELCOME</span>
          <span class="text-gold">•</span>
        </span>
        <span class="font-heading font-bold uppercase tracking-widest text-sm flex items-center gap-3">
          <span>MOST HOLY REDEEMER CHURCH</span>
          <span class="text-gold">•</span>
          <span>CUTES STUDENT FELLOWSHIP</span>
          <span class="text-gold">•</span>
          <span>UPSI TANJUNG MALIM</span>
          <span class="text-gold">•</span>
          <span>FAITH, HOPE & CHARITY</span>
          <span class="text-gold">•</span>
          <span>ALL ARE WELCOME</span>
          <span class="text-gold">•</span>
        </span>
      </div>
      <div class="marquee-track" aria-hidden="true">
        <span class="font-heading font-bold uppercase tracking-widest text-sm flex items-center gap-3">
          <span>MOST HOLY REDEEMER CHURCH</span>
          <span class="text-gold">•</span>
          <span>CUTES STUDENT FELLOWSHIP</span>
          <span class="text-gold">•</span>
          <span>UPSI TANJUNG MALIM</span>
          <span class="text-gold">•</span>
          <span>FAITH, HOPE & CHARITY</span>
          <span class="text-gold">•</span>
          <span>ALL ARE WELCOME</span>
          <span class="text-gold">•</span>
        </span>
        <span class="font-heading font-bold uppercase tracking-widest text-sm flex items-center gap-3">
          <span>MOST HOLY REDEEMER CHURCH</span>
          <span class="text-gold">•</span>
          <span>CUTES STUDENT FELLOWSHIP</span>
          <span class="text-gold">•</span>
          <span>UPSI TANJUNG MALIM</span>
          <span class="text-gold">•</span>
          <span>FAITH, HOPE & CHARITY</span>
          <span class="text-gold">•</span>
          <span>ALL ARE WELCOME</span>
          <span class="text-gold">•</span>
        </span>
      </div>
    </div>
  </section>

  <!-- 3. "WHY MOST HOLY REDEEMER & CUTES" (Reverse Engineered 3 Pillars from Fellowship Church) -->
  <section class="mx-auto max-w-[84rem] px-gutter py-20 sm:py-28">
    <div class="text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 rounded-full bg-magenta/10 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-magenta">
        <span class="h-1.5 w-1.5 rounded-full bg-magenta"></span>
        <span>A Place To Belong</span>
      </div>
      <h2 class="mt-4 font-heading text-3xl sm:text-5xl font-extrabold tracking-tight text-ink">
        <span class="italic font-serif text-magenta">Why</span> Most Holy Redeemer & CUTES
      </h2>
      <p class="mt-4 text-base sm:text-lg text-ink-soft">
        Whether you are a university student at UPSI living away from home or a lifelong local parishioner, here is what anchors our community.
      </p>
    </div>

    <!-- 3 Pillars Grid -->
    <div class="mt-14 grid gap-8 md:grid-cols-3">
      <!-- Pillar 1 -->
      <div class="church-card group flex flex-col justify-between">
        <div>
          <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-gold/15 text-gold-hover mb-6 group-hover:scale-110 transition-transform">
            <!-- Cross Icon -->
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 2v20m-7-14h14" />
            </svg>
          </div>
          <span class="text-xs font-bold uppercase tracking-widest text-gold-hover">Pillar 01</span>
          <h3 class="mt-2 font-heading text-2xl font-bold text-ink">
            <span class="italic font-serif text-purple">Christ</span> Centered Faith
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">
            Faith is not just for Sundays. Grounded in the Gospel, the Holy Eucharist, and sacraments, we provide spiritual anchorage for students and families facing daily university and work life.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-rule/60">
          <a href={localePath(lang, 'services')} class="text-xs font-bold text-purple hover:text-magenta transition-colors inline-flex items-center gap-1">
            <span>Explore Sacraments</span> &rarr;
          </a>
        </div>
      </div>

      <!-- Pillar 2 -->
      <div class="church-card group flex flex-col justify-between border-t-4 border-t-magenta">
        <div>
          <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-magenta/15 text-magenta mb-6 group-hover:scale-110 transition-transform">
            <!-- Fellowship / Hands Icon -->
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <span class="text-xs font-bold uppercase tracking-widest text-magenta">Pillar 02</span>
          <h3 class="mt-2 font-heading text-2xl font-bold text-ink">
            <span class="italic font-serif text-magenta">Active</span> Campus Fellowship
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">
            No judgment, no pretensions. At CUTES, university life is lived together with choir, sports, retreats, Gawai Kaamatan, and family days. You will find friends who pray, study, and laugh with you.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-rule/60">
          <a href={localePath(lang, 'cutes')} class="text-xs font-bold text-magenta hover:underline inline-flex items-center gap-1">
            <span>Life at CUTES</span> &rarr;
          </a>
        </div>
      </div>

      <!-- Pillar 3 -->
      <div class="church-card group flex flex-col justify-between">
        <div>
          <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-purple/15 text-purple mb-6 group-hover:scale-110 transition-transform">
            <!-- Heart / Love Icon -->
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
