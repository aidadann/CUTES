---
import { Image } from 'astro:assets';
import { render } from 'astro:content';

import logo from '../../assets/logo.jpg';
import EventCard from '../../components/EventCard.astro';
import MassScheduleTable from '../../components/MassScheduleTable.astro';
import { site } from '../../data/site';
import { useTranslations, type Lang } from '../../i18n/ui';
import { localeParams, localePath } from '../../i18n/utils';
import { localized, localizedEntry, splitEvents } from '../../lib/content';
import { listBulletins } from '../../lib/bulletin';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = localeParams;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const vision = await localizedEntry('pages', lang, 'vision-mission');
const { Content: Vision } = vision ? await render(vision) : { Content: null };

const { upcoming } = splitEvents(await localized('events', lang));
const nextEvents = upcoming.slice(0, 3);
const latestBulletin = listBulletins()[0];
---

<BaseLayout lang={lang} title={site.parishName} description={t('home.heroLead')} path="">
  <!-- Hero ---------------------------------------------------------------->
  <section class="relative overflow-hidden border-b border-line bg-surface-sunken">
    <div
      class="pointer-events-none absolute -end-24 -top-24 h-72 w-72 rotate-45 bg-gradient-to-br from-brand-gold/20 to-transparent"
      aria-hidden="true"
    >
    </div>

    <div class="mx-auto grid max-w-6xl gap-10 px-gutter py-16 sm:py-20 lg:grid-cols-[1.35fr_1fr] lg:items-center">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-gold-ink">
          {t('home.kicker')}
        </p>
        <h1 class="mt-3 font-display text-hero font-semibold">
          {site.parishName}
        </h1>
        <p class="mt-1 font-display text-xl text-content-muted sm:text-2xl">
          {site.town}, {site.state}
        </p>
        <p class="mt-6 max-w-xl text-lg text-content-muted">{t('home.heroLead')}</p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={localePath(lang, 'mass-schedule')}
            class="rounded-md bg-accent px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-accent-hover"
          >
            {t('home.ctaMass')}
          </a>
          <a
            href={localePath(lang, 'bulletin')}
            class="rounded-md border border-line-strong px-5 py-2.5 text-sm font-semibold transition-colors hover:border-accent hover:text-accent"
          >
            {t('home.ctaBulletin')}
            {latestBulletin && <span class="ms-1.5 text-content-muted">· {latestBulletin.iso}</span>}
          </a>
        </div>
      </div>

      <div class="justify-self-center lg:justify-self-end">
        <Image
          src={logo}
          alt={`${site.communityName} — ${site.communityFullName}`}
          width={320}
          height={320}
          loading="eager"
          fetchpriority="high"
          class="h-56 w-56 rounded-2xl object-cover shadow-lg ring-1 ring-line-strong sm:h-72 sm:w-72"
        />
      </div>
    </div>
  </section>

  <!-- Vision and mission -------------------------------------------------->
  {
    Vision && (
      <section class="mx-auto max-w-6xl px-gutter py-16">
        <h2 class="font-display text-2xl font-semibold sm:text-3xl">{t('home.visionTitle')}</h2>
        <div class="prose-page mt-6">
          <Vision />
        </div>
      </section>
    )
  }

  <!-- Mass schedule ------------------------------------------------------->
  <section class="border-y border-line bg-surface-sunken">
    <div class="mx-auto max-w-6xl px-gutter py-16">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="font-display text-2xl font-semibold sm:text-3xl">{t('home.scheduleTitle')}</h2>
          <p class="mt-1.5 text-content-muted">{t('home.scheduleLead')}</p>
        </div>
        <a href={localePath(lang, 'mass-schedule')} class="text-sm font-semibold hover:underline">
          {t('home.scheduleAll')} &rarr;
        </a>
      </div>

      <div class="mt-8">
        <MassScheduleTable lang={lang} highlightOnly />
      </div>
    </div>
  </section>

  <!-- Upcoming events ----------------------------------------------------->
  <section class="mx-auto max-w-6xl px-gutter py-16">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="font-display text-2xl font-semibold sm:text-3xl">{t('home.eventsTitle')}</h2>
      <a href={localePath(lang, 'events')} class="text-sm font-semibold hover:underline">
        {t('home.eventsAll')} &rarr;
      </a>
    </div>

    {
      nextEvents.length === 0 ? (
        <p class="mt-8 rounded-card border border-dashed border-line-strong px-5 py-10 text-center text-content-muted">
          {t('home.eventsEmpty')}
        </p>
      ) : (
        <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {nextEvents.map((entry) => (
            <li>
              <EventCard lang={lang} entry={entry} />
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <!-- CUTES band ---------------------------------------------------------->
  <section class="border-t border-line bg-accent-cutes-soft">
    <div class="mx-auto max-w-6xl px-gutter py-16">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent-cutes">
        {site.communityFullName}
      </p>
      <h2 class="mt-2 font-display text-2xl font-semibold sm:text-3xl">{t('home.cutesTitle')}</h2>
      <p class="mt-3 max-w-2xl text-content-muted">{t('home.cutesLead')}</p>
      <a
        href={localePath(lang, 'cutes')}
        class="mt-6 inline-block rounded-md bg-accent-cutes px-5 py-2.5 text-sm font-semibold text-white transition-opacity hover:opacity-90"
      >
        {t('home.cutesCta')}
      </a>
    </div>
  </section>
</BaseLayout>
