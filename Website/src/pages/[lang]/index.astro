---
import { getCollection } from 'astro:content';

import { site } from '../../data/site';
import { useTranslations, type Lang, type UiKey } from '../../i18n/ui';
import { eventWhen, localeParams, localePath, assetPath } from '../../i18n/utils';
import { localized, slugOf, splitEvents } from '../../lib/content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = localeParams;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const schedule = (await getCollection('massTimes')).sort((a, b) => a.data.order - b.data.order);

// Saturday's Rosary and sunset Mass, then Sunday's. Two blocks, each listing
// its devotion above the Mass it precedes.
const weekend = (['saturday', 'sunday'] as const).map((day) => ({
  day,
  rows: schedule.filter((entry) => entry.data.day === day),
}));
const { upcoming } = splitEvents(await localized('events', lang));
const nextEvents = upcoming.slice(0, 2);

// Council portraits are still being collected. Until a photo path is filled in
// for a member, their initials stand in — a missing face should look deliberate,
// not broken.
const initials = (name: string) =>
  name
    .split(' ')
    .filter(Boolean)
    .slice(-2)
    .map((word) => word[0]!.toUpperCase())
    .join('');
---

<BaseLayout lang={lang} title={site.parishName} description={t('home.heroStatement')} path="">
  <!-- 1. HERO SECTION (80-100vh on desktop, large photography, bold headline) -->
  <section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden bg-paper-shade text-white">
    <!-- Full-width photography with gentle contrast scrim -->
    <div class="absolute inset-0 z-0">
      <img
        src={assetPath('hero-community.jpg')}
        alt="Church fellowship and worship community"
        class="hero-media h-full w-full object-cover object-center filter brightness-[0.62] contrast-[1.05]"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-charcoal/85 via-charcoal/30 to-transparent"></div>
    </div>

    <div class="relative z-10 mx-auto max-w-[84rem] w-full px-gutter py-24 sm:py-32 flex flex-col justify-end min-h-[85vh]">
      <div class="hero-enter on-dark max-w-4xl">
        <h1
          class="hero-title font-heading text-5xl sm:text-7xl lg:text-8xl font-black uppercase tracking-[-0.04em] text-white leading-[0.98] drop-shadow-sm"
          style="--reveal-index: 0"
        >
          {t('home.heroHeadline')}
        </h1>

        <p
          class="mt-6 max-w-2xl text-lg sm:text-2xl font-normal text-white/90 leading-relaxed drop-shadow-xs"
          style="--reveal-index: 1"
        >
          {t('home.heroStatement')}
        </p>

        <p
          class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs sm:text-sm font-bold uppercase tracking-[0.25em] text-gold-light"
          style="--reveal-index: 2"
        >
          <span>{site.parishName}</span>
          <span aria-hidden="true" class="h-px w-8 self-center bg-gold-light/50"></span>
          <span>{site.diocese}, {site.country}</span>
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-4" style="--reveal-index: 3">
          <a
            href={site.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-action btn-primary !bg-white !text-charcoal hover:!bg-paper-shade !border-white"
          >
            <span>{t('home.ctaLocation')}</span>
            <span>&rarr;</span>
          </a>

          <a
            href={localePath(lang, 'contact')}
            class="btn-action btn-secondary !border-white/60 !text-white hover:!bg-white/10"
          >
            <span>{t('home.contactUs')}</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. INTRODUCTION SECTION (Spacious editorial two-column layout) -->
  <section class="bg-paper py-24 sm:py-36 border-b border-rule" id="intro">
    <div class="mx-auto max-w-[84rem] px-gutter">
      <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-20 items-start reveal-on-scroll">
        <div>
          <h2 class="font-heading text-3xl sm:text-5xl lg:text-6xl font-extrabold uppercase tracking-[-0.04em] text-ink leading-[1.05]">
            {t('home.introHeadline')}
          </h2>
        </div>

        <div class="space-y-6 text-lg sm:text-xl text-ink-soft leading-relaxed lg:pt-3">
          <p>
            {t('home.introMission')}
          </p>
          <div class="grid gap-4 pt-2 sm:grid-cols-2">
            <a
              href={localePath(lang, 'cutes')}
              class="group border-t-2 border-ink pt-4 no-underline transition-colors hover:border-accent"
            >
              <span class="font-heading text-xl font-bold uppercase text-ink group-hover:text-accent transition-colors">
                {t('home.meetCutesLabel')}
              </span>
              <span class="mt-1 block text-sm text-ink-soft">{t('home.meetCutesLead')}</span>
            </a>

            <a
              href={localePath(lang, 'cutes/bec')}
              class="group border-t-2 border-ink pt-4 no-underline transition-colors hover:border-accent"
            >
              <span class="font-heading text-xl font-bold uppercase text-ink group-hover:text-accent transition-colors">
                {t('home.meetBecLabel')}
              </span>
              <span class="mt-1 block text-sm text-ink-soft">{t('home.meetBecLead')}</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. ABOUT / CHURCH IDENTITY SECTION (Asymmetrical layout with large photo) -->
  <section class="bg-paper-shade py-24 sm:py-36 border-b border-rule" id="about">
    <div class="mx-auto max-w-[84rem] px-gutter">
      <div class="grid gap-12 lg:grid-cols-12 items-center">
        <!-- Asymmetrical Left: Large dominant photograph -->
        <div class="lg:col-span-7">
          <div class="reveal-image relative overflow-hidden rounded-[4px] shadow-sm aspect-[4/3] bg-paper-muted">
            <img
              src={assetPath('fellowship-casual.jpg')}
              alt="Community gathering and students fellowship"
              class="h-full w-full object-cover"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Asymmetrical Right: Editorial Content -->
        <div class="lg:col-span-5 lg:pl-6 reveal-on-scroll">
          <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-extrabold text-ink leading-[1.1]">
            {t('home.whoWeAreLead')}
          </h2>
          <p class="mt-6 text-base sm:text-lg text-ink-soft leading-relaxed">
            {t('home.whoWeAreBody')}
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a href={localePath(lang, 'parish/parish-history')} class="btn-action btn-secondary">
              <span>{t('nav.parishHistory')}</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. VALUES SECTION (Editorial magazine spread with horizontal rows) -->
  <section class="bg-paper py-24 sm:py-36 border-b border-rule">
    <div class="mx-auto max-w-[84rem] px-gutter">
      <div class="reveal-on-scroll">
        <h2 class="font-heading text-3xl sm:text-5xl font-extrabold uppercase tracking-[-0.04em] text-ink">
          {t('home.valuesTitle')}
        </h2>
      </div>

      <div class="mt-16 divide-y divide-rule border-y border-rule" data-stagger>
        <!-- Value 01 -->
        <div class="py-10 sm:py-14 grid gap-4 lg:grid-cols-[120px_1fr_2fr] items-start reveal-on-scroll">
          <span class="font-heading text-3xl sm:text-4xl font-black text-ink-muted">01</span>
          <h3 class="font-heading text-2xl sm:text-3xl font-bold uppercase tracking-tight text-ink">
            {t('home.v1Title')}
          </h3>
          <p class="text-base sm:text-lg text-ink-soft leading-relaxed">
            {t('home.v1Desc')}
          </p>
        </div>

        <!-- Value 02 -->
        <div class="py-10 sm:py-14 grid gap-4 lg:grid-cols-[120px_1fr_2fr] items-start reveal-on-scroll">
          <span class="font-heading text-3xl sm:text-4xl font-black text-ink-muted">02</span>
          <h3 class="font-heading text-2xl sm:text-3xl font-bold uppercase tracking-tight text-ink">
            {t('home.v2Title')}
          </h3>
          <p class="text-base sm:text-lg text-ink-soft leading-relaxed">
            {t('home.v2Desc')}
          </p>
        </div>

        <!-- Value 03 -->
        <div class="py-10 sm:py-14 grid gap-4 lg:grid-cols-[120px_1fr_2fr] items-start reveal-on-scroll">
          <span class="font-heading text-3xl sm:text-4xl font-black text-ink-muted">03</span>
          <h3 class="font-heading text-2xl sm:text-3xl font-bold uppercase tracking-tight text-ink">
            {t('home.v3Title')}
          </h3>
          <p class="text-base sm:text-lg text-ink-soft leading-relaxed">
            {t('home.v3Desc')}
          </p>
        </div>

        <!-- Value 04 -->
        <div class="py-10 sm:py-14 grid gap-4 lg:grid-cols-[120px_1fr_2fr] items-start reveal-on-scroll">
          <span class="font-heading text-3xl sm:text-4xl font-black text-ink-muted">04</span>
          <h3 class="font-heading text-2xl sm:text-3xl font-bold uppercase tracking-tight text-ink">
            {t('home.v4Title')}
          </h3>
          <p class="text-base sm:text-lg text-ink-soft leading-relaxed">
            {t('home.v4Desc')}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. SERVICES / SUNDAY SECTION (Split image/text layout, practical visiting info) -->
  <section class="bg-paper-shade py-24 sm:py-36 border-b border-rule" id="services">
    <div class="mx-auto max-w-[84rem] px-gutter">
      <div class="grid gap-12 lg:grid-cols-12 items-center">
        <!-- Practical Info Column -->
        <div class="lg:col-span-6 reveal-on-scroll">
          <h2 class="font-heading text-3xl sm:text-5xl font-extrabold uppercase tracking-[-0.04em] text-ink leading-[1.05]">
            {t('home.sundayTitle')}
          </h2>
          <p class="mt-4 text-base sm:text-lg text-ink-soft">
            {t('home.sundayLead')}
          </p>

          <div class="mt-10 space-y-6 border-y border-rule py-8">
            {weekend.map(({ day, rows }) => (
              <div class="flex items-start justify-between gap-4">
                <div>
                  <span class="text-xs font-bold uppercase tracking-wider text-ink-muted block">
                    {t('schedule.day')}
                  </span>
                  <span class="font-heading text-xl sm:text-2xl font-bold text-ink">
                    {t(`day.${day}` as UiKey)}
                  </span>
                </div>
                <div class="text-right">
                  <span class="text-xs font-bold uppercase tracking-wider text-ink-muted block">
                    {t('schedule.time')}
                  </span>
                  {rows.map((row) => (
                    <div class="font-heading text-lg sm:text-xl font-bold text-ink">
                      {row.data.time} • {row.data.kind === 'mass' ? t('schedule.mass') : t('schedule.rosary')}
                      <span class="block text-xs font-semibold uppercase tracking-wider text-ink-muted">
                        {row.data.language}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            ))}

            <div class="pt-4 border-t border-rule/60">
              <span class="text-xs font-bold uppercase tracking-wider text-ink-muted block">
                {t('schedule.location')}
              </span>
              <p class="mt-1 font-heading text-lg font-bold text-ink">
                {site.parishName}
              </p>
              <p class="text-sm text-ink-soft mt-0.5">
                {site.address.line2}, {site.address.postcode} {site.address.city}, {site.address.state}
              </p>
            </div>

            <p class="text-sm text-ink-soft">{t('schedule.confessionNote')}</p>
          </div>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a href={localePath(lang, 'bulletin')} class="btn-action btn-primary">
              <span>{t('nav.bulletin')}</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Sanctuary Atmosphere Image -->
        <div class="lg:col-span-6">
          <div class="reveal-image relative overflow-hidden rounded-[4px] shadow-sm aspect-[16/10] bg-paper-muted">
            <img
              src={assetPath('sunday-worship.jpg')}
              alt="Church sanctuary filled with natural light"
              class="h-full w-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. MINISTRIES SECTION (Large visual editorial tiles with responsive grid) -->
  <section class="bg-paper py-24 sm:py-36 border-b border-rule">
    <div class="mx-auto max-w-[84rem] px-gutter">
      <div class="flex flex-wrap items-end justify-between gap-6 pb-12 border-b border-rule reveal-on-scroll">
        <h2 class="font-heading text-3xl sm:text-5xl font-extrabold uppercase tracking-[-0.04em] text-ink">
          {t('home.ministriesTitle')}
        </h2>
        <p class="max-w-md text-sm sm:text-base text-ink-soft">
          {t('home.ministriesLead')}
        </p>
      </div>

      <div class="mt-12 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
        <!-- Tile 1: Liturgy & Altar Service -->
        <div class="ministry-entry group border-t border-ink pt-6 reveal-on-scroll">
          <h3 class="font-heading text-2xl font-bold uppercase text-ink group-hover:text-accent transition-colors">
            {t('ministry.liturgy')}
          </h3>
          <p class="mt-3 text-sm text-ink-soft leading-relaxed">
            Altar servers, lectors, and ministers assisting at the celebration of the Eucharist.
          </p>
          <a href={localePath(lang, 'cutes/committee')} class="mt-6 inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-ink group-hover:text-accent transition-colors">
            <span>Explore</span>
            <span class="ministry-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <!-- Tile 2: Choir & Music -->
        <div class="ministry-entry group border-t border-ink pt-6 reveal-on-scroll">
          <h3 class="font-heading text-2xl font-bold uppercase text-ink group-hover:text-accent transition-colors">
            {t('ministry.choir')}
          </h3>
          <p class="mt-3 text-sm text-ink-soft leading-relaxed">
            Leading the assembly in choral harmony and praise across the sunset masses and festive solemnities.
          </p>
          <a href={localePath(lang, 'cutes/committee')} class="mt-6 inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-ink group-hover:text-accent transition-colors">
            <span>Explore</span>
            <span class="ministry-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <!-- Tile 3: Multimedia & Outreach -->
        <div class="ministry-entry group border-t border-ink pt-6 reveal-on-scroll">
          <h3 class="font-heading text-2xl font-bold uppercase text-ink group-hover:text-accent transition-colors">
            {t('ministry.multimedia')}
          </h3>
          <p class="mt-3 text-sm text-ink-soft leading-relaxed">
            Capturing parish memories, publishing bulletins, and managing audio-visual equipment.
          </p>
          <a href={localePath(lang, 'cutes/committee')} class="mt-6 inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-ink group-hover:text-accent transition-colors">
            <span>Explore</span>
            <span class="ministry-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <!-- Tile 4: Transportation -->
        <div class="ministry-entry group border-t border-ink pt-6 reveal-on-scroll">
          <h3 class="font-heading text-2xl font-bold uppercase text-ink group-hover:text-accent transition-colors">
            {t('ministry.transportation')}
          </h3>
          <p class="mt-3 text-sm text-ink-soft leading-relaxed">
            Providing transit coordination for university students between UPSI residential colleges and church.
          </p>
          <a href={localePath(lang, 'cutes/committee')} class="mt-6 inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-ink group-hover:text-accent transition-colors">
            <span>Explore</span>
            <span class="ministry-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <!-- Tile 5: Recreation & Spiritual -->
        <div class="ministry-entry group border-t border-ink pt-6 reveal-on-scroll">
          <h3 class="font-heading text-2xl font-bold uppercase text-ink group-hover:text-accent transition-colors">
            {t('ministry.recreation')}
          </h3>
          <p class="mt-3 text-sm text-ink-soft leading-relaxed">
            Organizing retreats, Taizé prayer evenings, sports days, and student family gatherings.
          </p>
          <a href={localePath(lang, 'cutes/committee')} class="mt-6 inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-ink group-hover:text-accent transition-colors">
            <span>Explore</span>
            <span class="ministry-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <!-- Tile 6: every other ministry -->
        <a
          href={localePath(lang, 'cutes/committee')}
          class="ministry-entry group border-t border-ink pt-6 no-underline reveal-on-scroll"
        >
          <h3 class="font-heading text-2xl font-bold uppercase text-ink group-hover:text-accent transition-colors">
            {t('cutes.ministries')}
          </h3>
          <p class="mt-3 text-sm text-ink-soft leading-relaxed">
            {t('home.moreMinistries')}
          </p>
          <span class="mt-6 inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-ink group-hover:text-accent transition-colors">
            <span>Explore</span>
            <span class="ministry-arrow" aria-hidden="true">&rarr;</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- 7. PARISH PASTORAL COUNCIL -->
  <section class="bg-paper-shade py-24 sm:py-36 border-b border-rule">
    <div class="mx-auto max-w-[84rem] px-gutter">
      <div class="flex flex-wrap items-end justify-between gap-6 pb-12 border-b border-rule reveal-on-scroll">
        <h2 class="font-heading text-3xl sm:text-5xl font-extrabold uppercase tracking-[-0.04em] text-ink">
          {t('home.councilTitle')}
        </h2>
        <p class="max-w-md text-sm sm:text-base text-ink-soft">
          {t('home.councilLead')}
        </p>
      </div>

      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
        {site.council.map((member) => (
          <article class="church-card !p-8 flex flex-col items-center text-center reveal-on-scroll">
            {member.photo ? (
              <img
                src={assetPath(member.photo)}
                alt={member.name}
                class="h-32 w-32 rounded-full object-cover border-4 border-gold/50 shadow-sm"
                width="128"
                height="128"
                loading="lazy"
              />
            ) : (
              <div
                class="flex h-32 w-32 items-center justify-center rounded-full border-4 border-gold/50 bg-purple/10 font-heading text-4xl font-bold text-purple"
                aria-hidden="true"
              >
                {initials(member.name)}
              </div>
            )}

            <h3 class="mt-6 font-heading text-xl font-bold text-ink">{member.name}</h3>
            <p class="mt-1 text-xs font-bold uppercase tracking-wider text-purple">
              {t(member.roleKey as UiKey)}
            </p>

            <a
              href={`tel:${member.phone}`}
              class="mt-5 inline-flex items-center gap-2 border-b-2 border-ink pb-1 text-sm font-bold tabular text-ink transition-colors hover:border-accent hover:text-accent"
            >
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span class="sr-only">{t('home.councilCall')} {member.name} —</span>
              <span>{member.phoneDisplay}</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. EVENTS SECTION (Clean horizontal dated rows with arrows) -->
  <section class="bg-paper py-24 sm:py-36 border-b border-rule">
    <div class="mx-auto max-w-[84rem] px-gutter">
      <div class="flex flex-wrap items-end justify-between gap-6 pb-12 border-b border-rule reveal-on-scroll">
        <h2 class="font-heading text-3xl sm:text-5xl font-extrabold uppercase tracking-[-0.04em] text-ink">
          {t('home.eventsTitle')}
        </h2>
        <a href={localePath(lang, 'events')} class="btn-action btn-secondary !py-2.5 !px-5 !text-xs">
          <span>{t('home.eventsAll')}</span> &rarr;
        </a>
      </div>

      {nextEvents.length === 0 ? (
        <div class="mt-12 border border-rule bg-paper-shade p-12 text-center text-ink-soft reveal-on-scroll">
          <p class="text-lg">{t('home.eventsEmpty')}</p>
        </div>
      ) : (
        <div class="divide-y divide-rule border-b border-rule" data-stagger>
          {nextEvents.map((event) => (
            <a
              href={localePath(lang, `events/${slugOf(event.id)}`)}
              class="group py-8 sm:py-10 grid gap-4 sm:grid-cols-[200px_1fr_auto] items-center transition-colors hover:bg-paper-shade/40 px-2 reveal-on-scroll"
            >
              <div class="text-sm font-bold uppercase tracking-wider text-accent">
                {eventWhen(event.data, lang, t('events.dateTbd'))}
              </div>
              <div>
                <h3 class="font-heading text-xl sm:text-2xl font-bold text-ink group-hover:text-accent transition-colors">
                  {event.data.title}
                </h3>
                <p class="mt-1 text-sm text-ink-soft line-clamp-1">
                  {event.data.summary}
                </p>
              </div>
              <div class="hidden sm:flex items-center text-ink-muted group-hover:text-ink transition-colors">
                <span class="event-arrow text-xl" aria-hidden="true">&rarr;</span>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

</BaseLayout>

<style>
  .ministry-arrow,
  .event-arrow {
    display: inline-block;
    transition: transform var(--dur-state) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .group:hover .ministry-arrow {
      transform: translateX(4px);
    }

    .group:hover .event-arrow {
      transform: translateX(6px);
    }

    /* The rule above each ministry entry draws itself in as the entry arrives,
       so the index reads as being set rather than as six boxes appearing. */
    .ministry-entry:hover {
      border-top-color: var(--color-accent);
    }
  }

  .ministry-entry {
    transition: border-color var(--dur-state) ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .ministry-arrow,
    .event-arrow {
      transition: none;
    }
  }
</style>
