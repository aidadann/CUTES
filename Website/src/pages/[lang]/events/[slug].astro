---
import { Image } from 'astro:assets';
import { render } from 'astro:content';

import PageHeader from '../../../components/PageHeader.astro';
import { languages, useTranslations, type Lang } from '../../../i18n/ui';
import { formatDateRange, localePath } from '../../../i18n/utils';
import { localizedPaths } from '../../../lib/content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  return localizedPaths('events', Object.keys(languages) as Lang[]);
}

const { entry } = Astro.props;
const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug as string;
const t = useTranslations(lang);
const { Content } = await render(entry);

const when = formatDateRange(entry.data.startDate, entry.data.endDate, lang);
---

<BaseLayout
  lang={lang}
  title={entry.data.title}
  description={entry.data.summary}
  path={`events/${slug}`}
  type="article"
>
  <PageHeader
    lang={lang}
    title={entry.data.title}
    lead={entry.data.summary}
    note={when}
    crumbs={[{ label: t('events.title'), href: localePath(lang, 'events') }]}
  />

  <div class="mx-auto max-w-[80rem] px-gutter pb-16">
    {
      entry.data.cover && (
        <Image
          src={entry.data.cover}
          alt={entry.data.coverAlt ?? ''}
          width={1400}
          height={700}
          loading="eager"
          class="mb-12 h-[clamp(14rem,32vw,26rem)] w-full object-cover"
        />
      )
    }

    <div class="grid gap-12 border-t border-ink pt-10 lg:grid-cols-[1fr_18rem] lg:gap-16">
      <div class="reading">
        <Content />
      </div>

      <aside class="lg:sticky lg:top-8 lg:self-start">
        <dl>
          <div class="border-b border-rule pb-3">
            <dt class="text-ink-soft">{t('events.when')}</dt>
            <dd class="mt-0.5 font-semibold">
              <time datetime={entry.data.startDate.toISOString().slice(0, 10)}>{when}</time>
            </dd>
          </div>
          <div class="border-b border-rule py-3">
            <dt class="text-ink-soft">{t('events.where')}</dt>
            <dd class="mt-0.5 font-semibold">{entry.data.location}</dd>
          </div>
        </dl>

        {
          entry.data.registrationUrl && (
            <a
              href={entry.data.registrationUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="button mt-6 block text-center"
            >
              {t('events.register')}
            </a>
          )
        }

        {
          entry.data.gallery && (
            <a href={localePath(lang, `gallery/${entry.data.gallery}`)} class="link mt-5 inline-block">
              {t('events.viewGallery')}
            </a>
          )
        }
      </aside>
    </div>
  </div>
</BaseLayout>
