---
import { Image } from 'astro:assets';
import { render } from 'astro:content';

import PageHeader from '../../../components/PageHeader.astro';
import { languages, useTranslations, type Lang } from '../../../i18n/ui';
import { formatDateRange, localePath } from '../../../i18n/utils';
import { localizedPaths } from '../../../lib/content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  return localizedPaths('events', Object.keys(languages) as Lang[]);
}

const { entry } = Astro.props;
const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug as string;
const t = useTranslations(lang);
const { Content } = await render(entry);

const when = formatDateRange(entry.data.startDate, entry.data.endDate, lang);
---

<BaseLayout
  lang={lang}
  title={entry.data.title}
  description={entry.data.summary}
  path={`events/${slug}`}
  type="article"
>
  <PageHeader
    lang={lang}
    title={entry.data.title}
    lead={entry.data.summary}
    kicker={when}
    crumbs={[{ label: t('events.title'), href: localePath(lang, 'events') }]}
  />

  <div class="mx-auto max-w-6xl px-gutter py-12">
    <div class="grid gap-10 lg:grid-cols-[1fr_18rem] lg:items-start">
      <div>
        {
          entry.data.cover && (
            <Image
              src={entry.data.cover}
              alt={entry.data.coverAlt ?? ''}
              width={1200}
              height={675}
              loading="eager"
              class="mb-8 w-full rounded-card object-cover"
            />
          )
        }

        <div class="prose-page">
          <Content />
        </div>
      </div>

      <aside class="rounded-card border border-line bg-surface-sunken p-5 lg:sticky lg:top-24">
        <dl class="space-y-4 text-sm">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-content-muted">
              {t('events.when')}
            </dt>
            <dd class="mt-1 font-medium">
              <time datetime={entry.data.startDate.toISOString().slice(0, 10)}>{when}</time>
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-content-muted">
              {t('events.where')}
            </dt>
            <dd class="mt-1 font-medium">{entry.data.location}</dd>
          </div>
        </dl>

        {
          entry.data.registrationUrl && (
            <a
              href={entry.data.registrationUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-5 block rounded-md bg-accent px-4 py-2.5 text-center text-sm font-semibold text-white transition-colors hover:bg-accent-hover"
            >
              {t('events.register')}
            </a>
          )
        }

        {
          entry.data.gallery && (
            <a
              href={localePath(lang, `gallery/${entry.data.gallery}`)}
              class="mt-3 block rounded-md border border-line-strong px-4 py-2.5 text-center text-sm font-semibold transition-colors hover:border-accent hover:text-accent"
            >
              {t('events.viewGallery')}
            </a>
          )
        }
      </aside>
    </div>
  </div>
</BaseLayout>
