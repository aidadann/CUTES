---
import EventCard from '../../../components/EventCard.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { useTranslations, type Lang } from '../../../i18n/ui';
import { localeParams } from '../../../i18n/utils';
import { localized, splitEvents } from '../../../lib/content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export const getStaticPaths = localeParams;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const { upcoming, past } = splitEvents(await localized('events', lang));
---

<BaseLayout lang={lang} title={t('events.title')} description={t('events.lead')} path="events">
  <PageHeader lang={lang} title={t('events.title')} lead={t('events.lead')} />

  <div class="mx-auto max-w-[80rem] px-gutter pb-16">
    <section>
      <h2 class="text-xl font-semibold">{t('events.upcoming')}</h2>
      {
        upcoming.length === 0 ? (
          <p class="mt-4 border-t border-ink pt-6 text-ink-soft">{t('events.emptyUpcoming')}</p>
        ) : (
          <div class="mt-4 border-t border-ink">
            {upcoming.map((entry) => (
              <EventCard lang={lang} entry={entry} />
            ))}
          </div>
        )
      }
    </section>

    {
      past.length > 0 && (
        <section class="mt-16">
          <h2 class="text-xl font-semibold">{t('events.past')}</h2>
          <div class="mt-4 border-t border-ink">
            {past.map((entry) => (
              <EventCard lang={lang} entry={entry} past />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
