---
import EventCard from '../../../components/EventCard.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { useTranslations, type Lang } from '../../../i18n/ui';
import { localeParams } from '../../../i18n/utils';
import { localized, splitEvents } from '../../../lib/content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export const getStaticPaths = localeParams;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const { upcoming, past } = splitEvents(await localized('events', lang));
---

<BaseLayout lang={lang} title={t('events.title')} description={t('events.lead')} path="events">
  <PageHeader lang={lang} title={t('events.title')} lead={t('events.lead')} />

  <div class="mx-auto max-w-6xl px-gutter py-12">
    <section>
      <h2 class="font-display text-xl font-semibold">{t('events.upcoming')}</h2>
      {
        upcoming.length === 0 ? (
          <p class="mt-4 rounded-card border border-dashed border-line-strong px-5 py-10 text-center text-content-muted">
            {t('events.emptyUpcoming')}
          </p>
        ) : (
          <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {upcoming.map((entry) => (
              <li>
                <EventCard lang={lang} entry={entry} />
              </li>
            ))}
          </ul>
        )
      }
    </section>

    {
      past.length > 0 && (
        <section class="mt-16">
          <h2 class="font-display text-xl font-semibold">{t('events.past')}</h2>
          <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {past.map((entry) => (
              <li>
                <EventCard lang={lang} entry={entry} past />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
