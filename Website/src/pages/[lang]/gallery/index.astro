---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

import PageHeader from '../../../components/PageHeader.astro';
import { useTranslations, type Lang } from '../../../i18n/ui';
import { localeParams, localePath } from '../../../i18n/utils';
import { albumCount, albumCover } from '../../../lib/gallery';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export const getStaticPaths = localeParams;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const albums = (await getCollection('albums'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((album) => ({
    id: album.data.id,
    title: album.data.title[lang],
    description: album.data.description?.[lang],
    cover: albumCover(album.data.id),
    count: albumCount(album.data.id),
  }));

const totalPhotos = albums.reduce((sum, album) => sum + album.count, 0);
---

<BaseLayout lang={lang} title={t('gallery.title')} description={t('gallery.lead')} path="gallery">
  <PageHeader lang={lang} title={t('gallery.title')} lead={t('gallery.lead')} accent="magenta" />

  <div class="mx-auto max-w-6xl px-gutter py-12">
    {
      totalPhotos === 0 && (
        <p class="mb-8 rounded-card border border-dashed border-line-strong px-5 py-6 text-center text-sm text-content-muted">
          {t('gallery.emptyAll')}
        </p>
      )
    }

    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        albums.map((album) => (
          <li>
            <a
              href={localePath(lang, `gallery/${album.id}`)}
              class="group flex h-full flex-col overflow-hidden rounded-card border border-line bg-surface-raised transition-shadow hover:shadow-md"
            >
              <div class="aspect-[4/3] overflow-hidden bg-surface-sunken">
                {album.cover ? (
                  <Image
                    src={album.cover}
                    alt=""
                    width={600}
                    height={450}
                    widths={[400, 600, 900]}
                    sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                  />
                ) : (
                  <div
                    class="flex h-full w-full items-center justify-center bg-gradient-to-br from-accent-cutes-soft to-surface-sunken"
                    aria-hidden="true"
                  >
                    <span class="block h-9 w-9 rotate-45 border-2 border-brand-gold" />
                  </div>
                )}
              </div>

              <div class="flex grow flex-col p-5">
                <h2 class="font-display text-lg font-semibold group-hover:text-accent-cutes">
                  {album.title}
                </h2>
                {album.description && (
                  <p class="mt-1.5 text-sm text-content-muted">{album.description}</p>
                )}
                <p class="mt-3 text-xs uppercase tracking-[0.1em] text-content-muted">
                  {album.count}{' '}
                  {album.count === 1 ? t('gallery.photoCountOne') : t('gallery.photoCount')}
                </p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
