---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

import PageHeader from '../../../components/PageHeader.astro';
import { useTranslations, type Lang } from '../../../i18n/ui';
import { localeParams, localePath } from '../../../i18n/utils';
import { albumCount, albumCover } from '../../../lib/gallery';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export const getStaticPaths = localeParams;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const albums = (await getCollection('albums'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((album) => ({
    id: album.data.id,
    title: album.data.title[lang],
    description: album.data.description?.[lang],
    cover: albumCover(album.data.id),
    count: albumCount(album.data.id),
  }));

const totalPhotos = albums.reduce((sum, album) => sum + album.count, 0);
---

<BaseLayout lang={lang} title={t('gallery.title')} description={t('gallery.lead')} path="gallery">
  <PageHeader lang={lang} title={t('gallery.title')} lead={t('gallery.lead')} accent="cutes" />

  <div class="mx-auto max-w-[80rem] px-gutter pb-16">
    {
      totalPhotos === 0 && (
        <p class="mb-10 max-w-[52ch] border-t border-rule pt-6 font-serif text-lg text-ink-soft">
          {t('gallery.emptyAll')}
        </p>
      )
    }

    <ul class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        albums.map((album) => (
          <li>
            <a href={localePath(lang, `gallery/${album.id}`)} class="block no-underline">
              <div class="aspect-[4/3] overflow-hidden bg-paper-shade">
                {album.cover ? (
                  <Image
                    src={album.cover}
                    alt=""
                    width={600}
                    height={450}
                    widths={[400, 600, 900]}
                    sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover"
                  />
                ) : (
                  /* An empty album is honest about being empty rather than
                     filling the space with a decorative placeholder. */
                  <div
                    class="flex h-full w-full items-end p-4 text-sm text-ink-soft"
                    aria-hidden="true"
                  >
                    {t('gallery.emptyAll')}
                  </div>
                )}
              </div>

              <h2 class="mt-3 text-lg font-semibold">{album.title}</h2>
              {album.description && (
                <p class="mt-1 font-serif text-[0.9375rem] text-ink-soft">{album.description}</p>
              )}
              <p class="mt-1.5 text-sm text-ink-soft">
                <span class="tabular">{album.count}</span>{' '}
                {album.count === 1 ? t('gallery.photoCountOne') : t('gallery.photoCount')}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
