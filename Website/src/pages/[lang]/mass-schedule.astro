---
import MassScheduleTable from '../../components/MassScheduleTable.astro';
import PageHeader from '../../components/PageHeader.astro';
import { site } from '../../data/site';
import { useTranslations, type Lang } from '../../i18n/ui';
import { localeParams, localePath } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = localeParams;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const sections = [
  { kind: 'mass' as const, heading: t('schedule.title') },
  { kind: 'confession' as const, heading: t('schedule.confession') },
  { kind: 'adoration' as const, heading: t('schedule.devotions') },
];
---

<BaseLayout
  lang={lang}
  title={t('schedule.title')}
  description={t('home.scheduleLead')}
  path="mass-schedule"
>
  <PageHeader
    lang={lang}
    title={t('schedule.title')}
    lead={t('home.scheduleLead')}
    crumbs={[{ label: t('nav.parish'), href: localePath(lang, 'parish') }]}
  />

  <div class="mx-auto max-w-[80rem] px-gutter pb-16">
    {
      sections.map((section) => (
        <section class="mb-14">
          <h2 class="mb-4 text-xl font-semibold">{section.heading}</h2>
          <MassScheduleTable lang={lang} kind={section.kind} />
        </section>
      ))
    }

    <aside class="max-w-[52ch] border-t border-rule pt-6 text-ink-soft" data-print="hide">
      <p>{t('schedule.holyDays')}</p>
      <p class="mt-3">
        <a href={localePath(lang, 'bulletin')} class="link text-ink">{t('nav.bulletin')}</a>
      </p>
      <p class="mt-4">
        {site.address.line2}, {site.address.postcode} {site.address.city}, {site.address.state}
      </p>
    </aside>
  </div>
</BaseLayout>
