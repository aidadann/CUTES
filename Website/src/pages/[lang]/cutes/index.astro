---
import { render } from 'astro:content';

import { site } from '../../../data/site';
import { useTranslations, type Lang } from '../../../i18n/ui';
import { localeParams, localePath } from '../../../i18n/utils';
import { localizedEntry } from '../../../lib/content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export const getStaticPaths = localeParams;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const about = await localizedEntry('pages', lang, 'about-cutes');
const { Content } = about ? await render(about) : { Content: null };

const links = [
  { title: t('nav.lifeAtCutes'), href: localePath(lang, 'cutes/life') },
  { title: t('nav.committee'), href: localePath(lang, 'cutes/committee') },
  { title: t('nav.bec'), href: localePath(lang, 'cutes/bec') },
  { title: t('nav.gallery'), href: localePath(lang, 'gallery') },
];
---

<BaseLayout
  lang={lang}
  title={t('nav.aboutCutes')}
  description={about?.data.summary ?? t('home.cutesLead')}
  path="cutes"
>
  {/* CUTES gets the community's own colour, full bleed, the same way it does
      on the home page. It is a students' section inside a parish site and it
      should feel like walking into a different room. */}
  <div style="background: var(--color-cutes-band); color: #fff">
    <div class="mx-auto max-w-[80rem] px-gutter pb-16 pt-14 sm:pb-20 sm:pt-20">
      <h1 class="text-[clamp(3rem,2rem+5vw,6rem)] font-semibold leading-none">
        {site.communityName}
      </h1>
      <p class="mt-4 text-lg text-white/80 sm:text-xl">{site.communityFullName}</p>
      <p class="mt-6 max-w-[52ch] font-serif text-lg leading-relaxed text-white/90">
        {about?.data.summary ?? t('home.cutesLead')}
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-[80rem] px-gutter py-14">
    <div class="reading">
      {Content ? <Content /> : <p class="text-ink-soft">{t('common.todo')}</p>}
    </div>

    <nav class="mt-16 border-t border-ink pt-6" aria-label={t('common.moreIn')}>
      <ul class="flex flex-wrap gap-x-8 gap-y-2 text-lg font-semibold">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="no-underline hover:underline">
                {link.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</BaseLayout>
