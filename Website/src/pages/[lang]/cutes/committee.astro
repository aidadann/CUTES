---
import { getCollection } from 'astro:content';

import MinistryRoster from '../../../components/MinistryRoster.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { site } from '../../../data/site';
import { useTranslations, type Lang, type UiKey } from '../../../i18n/ui';
import { localeParams, localePath } from '../../../i18n/utils';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export const getStaticPaths = localeParams;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const ministries = (await getCollection('ministries')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  lang={lang}
  title={t('cutes.committeeTitle')}
  description={t('cutes.committeeLead')}
  path="cutes/committee"
>
  <PageHeader
    lang={lang}
    title={t('cutes.committeeTitle')}
    lead={t('cutes.committeeLead')}
    note={`${t('cutes.year')} ${site.committeeYear}`}
    crumbs={[{ label: t('nav.cutes'), href: localePath(lang, 'cutes') }]}
    accent="cutes"
  />

  <div class="mx-auto max-w-[80rem] px-gutter pb-16">
    <!-- On a page of sixty names a jump list is the difference between usable
         and not, especially on a phone. -->
    <nav aria-label={t('cutes.ministries')} data-print="hide" class="border-t border-rule pt-5">
      <ul class="flex flex-wrap gap-x-6 gap-y-1.5 text-[0.9375rem] text-ink-soft">
        {
          ministries.map((ministry) => (
            <li>
              <a href={`#${ministry.data.id}`} class="no-underline hover:underline">
                {t(`ministry.${ministry.data.id}` as UiKey)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mt-12 grid gap-12 lg:grid-cols-2 lg:gap-x-16">
      {ministries.map((ministry) => <MinistryRoster lang={lang} ministry={ministry} />)}
    </div>
  </div>
</BaseLayout>
