---
/**
 * The root of the site is a language chooser that chooses for you.
 *
 * A real page rather than an Astro `redirect`, for two reasons: it can read the
 * browser's preferred language, and it still works when JavaScript is off,
 * where the meta refresh takes over and the two links are visible in the
 * meantime.
 */
import { localePath } from '../i18n/utils';
import { site } from '../data/site';

const en = localePath('en');
const ms = localePath('ms');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${en}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={en} />
    <title>{site.parishName}, {site.town}</title>
    <style>
      /* Standalone: this page loads before the site's stylesheet, so it
         carries its own copy of the palette. Keep the two in step. */
      body {
        margin: 0;
        min-height: 100dvh;
        display: grid;
        place-content: center;
        gap: 1.25rem;
        text-align: center;
        font-family: system-ui, sans-serif;
        background: #fff;
        color: #000;
      }
      p {
        margin: 0;
      }
      a {
        color: #000;
        font-weight: 600;
        text-underline-offset: 0.2em;
      }
      .sep {
        color: #a8a19a;
        margin: 0 0.6em;
      }
      @media (prefers-color-scheme: dark) {
        body {
          background: #0d0c0b;
          color: #f6f3ee;
        }
        a {
          color: #f6f3ee;
        }
      }
    </style>
    <script is:inline define:vars={{ en, ms }}>
      // Send Malaysian-language browsers to /ms/ before the meta refresh fires.
      const prefersMalay = (navigator.languages ?? [navigator.language ?? ''])
        .join(',')
        .toLowerCase()
        .split(',')
        .some((tag) => tag.startsWith('ms') || tag.startsWith('id'));
      window.location.replace(prefersMalay ? ms : en);
    </script>
  </head>
  <body>
    <p>{site.parishName}, {site.town}</p>
    <p>
      <a href={en}>English</a><span class="sep" aria-hidden="true">/</span><a href={ms}>Bahasa Malaysia</a>
    </p>
  </body>
</html>
