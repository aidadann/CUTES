---
/**
 * A single 404 for the whole site.
 *
 * It cannot know the visitor's language — the URL that failed might be in
 * either tree — so it offers both. Cloudflare Pages and GitHub Pages both serve
 * /404.html automatically; nothing needs configuring.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { nav } from '../i18n/nav';
import { useTranslations } from '../i18n/ui';
import { localePath } from '../i18n/utils';

const t = useTranslations('en');
const tMs = useTranslations('ms');
---

<BaseLayout lang="en" title={t('404.title')} description={t('404.lead')} path="" noindex>
  <div class="mx-auto max-w-3xl px-gutter py-20 text-center">
    <p class="font-display text-6xl font-semibold text-brand-gold">404</p>
    <h1 class="mt-4 font-display text-3xl font-semibold">{t('404.title')}</h1>
    <p class="mt-3 text-content-muted">{t('404.lead')}</p>
    <p class="mt-1 text-sm text-content-muted" lang="ms">{tMs('404.lead')}</p>

    <ul class="mt-10 flex flex-wrap justify-center gap-2">
      {
        nav.map((item) => (
          <li>
            <a
              href={localePath('en', item.path)}
              class="link-quiet inline-block rounded-md border border-line px-3.5 py-2 text-sm transition-colors hover:border-accent hover:text-accent"
            >
              {t(item.key)}
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-10 text-sm">
      <a href={localePath('ms')} lang="ms" class="hover:underline">Bahasa Malaysia</a>
    </p>
  </div>
</BaseLayout>
