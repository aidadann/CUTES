---
/**
 * A single 404 for the whole site.
 *
 * It cannot know the visitor's language — the URL that failed might be in
 * either tree — so it offers both. Cloudflare Pages and GitHub Pages both
 * serve /404.html automatically; nothing needs configuring.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { nav } from '../i18n/nav';
import { useTranslations } from '../i18n/ui';
import { localePath } from '../i18n/utils';

const t = useTranslations('en');
const tMs = useTranslations('ms');
---

<BaseLayout lang="en" title={t('404.title')} description={t('404.lead')} path="" noindex>
  <div class="mx-auto max-w-[80rem] px-gutter py-20">
    <h1 class="text-[clamp(2rem,1.4rem+2.6vw,3.5rem)] font-semibold">{t('404.title')}</h1>
    <p class="mt-4 max-w-[52ch] font-serif text-lg text-ink-soft">{t('404.lead')}</p>
    <p class="mt-1 max-w-[52ch] font-serif text-lg text-ink-soft" lang="ms">{tMs('404.lead')}</p>

    <ul class="mt-12 max-w-[36rem] border-t border-ink">
      {
        nav.map((item) => (
          <li class="border-b border-rule">
            <a href={localePath('en', item.path)} class="block py-3.5 no-underline hover:underline">
              {t(item.key)}
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-8">
      <a href={localePath('ms')} lang="ms" class="link">Bahasa Malaysia</a>
    </p>
  </div>
</BaseLayout>
