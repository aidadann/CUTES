{"nodes": [{"id": "readme_repository_layout", "label": "Repository Layout", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_static_site_no_server", "label": "Static Site, No Server", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No database, no admin login, no server to maintain. Every page is generated from repository files and served as plain HTML from a CDN, so if nobody touches it for two years it still works."}, {"id": "readme_bulletin_filename_rule", "label": "Bulletin Filename Rule YYYY-MM-DD.pdf", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The filename is the entire publishing specification: sorting, the displayed date and the Latest label all fall out of it, so publishing needs no metadata form and no CMS."}, {"id": "readme_dual_deployment", "label": "Dual Deployment: GitHub Pages and Cloudflare Pages", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both targets are free and build from the same repository. BASE_PATH is set on GitHub Pages (served from /CUTES/) and left unset on Cloudflare (custom domain served from the root)."}, {"id": "readme_handover_ownership", "label": "Handover and Repository Ownership", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The repo must be owned by the parish or a parish-controlled organisation, not a student account: a student graduates, an organisation does not. At least two admins, one of whom is not a student. Everything else can be relearned in an afternoon; access cannot."}, {"id": "readme_npm_scripts", "label": "npm Command Reference", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_windows_ebusy_note", "label": "Windows EBUSY Build Note", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On Windows a build can end with EBUSY while clearing dist/; the site is already built correctly at that point. Does not occur on the deploy server."}, {"id": "readme_fail_build_over_blank_page", "label": "Fail the Build Rather Than Ship a Blank Page", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A missing required field in Markdown or YAML stops the build on purpose: a failed build is better than a blank page in front of the parish."}], "edges": [{"source": "readme_repository_layout", "target": "contributing_browser_only_editing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_repository_layout", "target": "requirement_tech_stack_astro", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_repository_layout", "target": "requirement_implementation_plan_build_order", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_repository_layout", "target": "contributing_before_launch_todo", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source