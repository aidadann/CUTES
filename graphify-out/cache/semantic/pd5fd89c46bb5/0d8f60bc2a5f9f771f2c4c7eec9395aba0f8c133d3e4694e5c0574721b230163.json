{"nodes": [{"id": "requirement_implementation_plan_decisions_log", "label": "Decisions Log", "file_type": "document", "source_file": "Requirement/IMPLEMENTATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Settles the questions left open in TECH_STACK.md and forbids reopening them during the build: bulletin is a weekly PDF (no CMS), bilingual from day one (a missing translation is a launch blocker), full per-module specification."}, {"id": "requirement_implementation_plan_m0_project_foundation", "label": "M0 \u2014 Project Foundation", "file_type": "document", "source_file": "Requirement/IMPLEMENTATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "requirement_implementation_plan_m1_i18n_core", "label": "M1 \u2014 i18n Core", "file_type": "document", "source_file": "Requirement/IMPLEMENTATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The English fallback in useTranslations is deliberate: a missing Bahasa Malaysia string renders English rather than an empty element. Missing translations are tracked in the authoring checklist, not enforced by a crash."}, {"id": "requirement_implementation_plan_m2_layout_and_chrome", "label": "M2 \u2014 Layout and Chrome", "file_type": "document", "source_file": "Requirement/IMPLEMENTATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dropdowns are details/summary so the menu works with zero JavaScript; accessibility floor is a skip link, landmarks, visible focus rings, and gold used only at heading sizes where its contrast holds."}, {"id": "requirement_implementation_plan_m3_content_collections", "label": "M3 \u2014 Content Collections", "file_type": "document", "source_file": "Requirement/IMPLEMENTATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "committee, gallery and schedule are language-neutral; roles are stored as keys and translated through ui.ts so a Bahasa Malaysia label can be renamed without touching the roster."}, {"id": "requirement_implementation_plan_m4_home", "label": "M4 \u2014 Home", "file_type": "document", "source_file": "Requirement/IMPLEMENTATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\"Today\" is the build date on a static site, so events fall off only on the next deploy. Acceptable because Cloudflare rebuilds on every push and the bulletin is uploaded weekly \u2014 add a scheduled rebuild if it ever matters, do not add a server."}, {"id": "requirement_implementation_plan_m5_main_parish", "label": "M5 \u2014 Main / Parish", "file_type": "document", "source_file": "Requirement/IMPLEMENTATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One template covers Parish Priest, Deacon and Parish History across two locales. The bulletin index is the only logic: glob the PDFs, sort by basename, reverse, label the newest \"This week\"."}, {"id": "requirement_implementation_plan_m6_cutes", "label": "M6 \u2014 CUTES", "file_type": "document", "source_file": "Requirement/IMPLEMENTATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The largest content module: roughly sixty names across eight fixed-order groupings, and the yearly handover is one YAML file edit."}, {"id": "requirement_implementation_plan_m7_events", "label": "M7 \u2014 Events", "file_type": "document", "source_file": "Requirement/IMPLEMENTATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "requirement_implementation_plan_m8_gallery", "label": "M8 \u2014 Gallery", "file_type": "document", "source_file": "Requirement/IMPLEMENTATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Photos live in src/assets so astro:assets processes them, never in public/. Built last on purpose: heaviest module, needs photos the committee must supply, and nothing else depends on it \u2014 if the launch slips, ship without it."}, {"id": "requirement_implementation_plan_m9_services", "label": "M9 \u2014 Services", "file_type": "document", "source_file": "Requirement/IMPLEMENTATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "requirement_implementation_plan_m10_resources", "label": "M10 \u2014 Resources", "file_type": "document", "source_file": "Requirement/IMPLEMENTATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The prayer list is open-ended so the template must not hard-code three. A print stylesheet is required because someone will print these."}, {"id": "requirement_implementation_plan_m11_contact", "label": "M11 \u2014 Contact", "file_type": "document", "source_file": "Requirement/IMPLEMENTATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "requirement_implementation_plan_m12_deploy_and_handover", "label": "M12 \u2014 Deploy and Handover", "file_type": "document", "source_file": "Requirement/IMPLEMENTATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pushing to a parish-owned GitHub organisation rather than a student account is called the single most important line in the document: a graduating student's account is how the site is lost."}, {"id": "requirement_implementation_plan_build_order", "label": "Build Order Phases", "file_type": "document", "source_file": "Requirement/IMPLEMENTATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "M3 precedes M2 in Phase 1 so the layout renders against real typed data instead of placeholder markup that gets thrown away; the gallery is Phase 4 because it is heaviest and nothing depends on it."}, {"id": "requirement_implementation_plan_content_authoring_checklist", "label": "Content Authoring Checklist", "file_type": "document", "source_file": "Requirement/IMPLEMENTATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The translation tracker: every row needs both locale files before launch, since the fallback renders English instead of failing."}, {"id": "requirement_implementation_plan_deferred_with_trigger", "label": "Deferred, with the Trigger That Un-defers It", "file_type": "rationale", "source_file": "Requirement/IMPLEMENTATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each deferral names the concrete event that reverses it (a CMS when the committee says the upload flow is too hard in those words; search past fifty pages; analytics when the committee has a question page views would answer). Each is cheap to add later and expensive to carry now."}, {"id": "requirement_implementation_plan_schema_as_test_suite", "label": "Schema Validation as the Test Suite", "file_type": "rationale", "source_file": "Requirement/IMPLEMENTATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A malformed committee entry must fail astro build rather than render an empty row, so zod schemas stand in for a conventional test suite on a site with no server logic."}, {"id": "requirement_implementation_plan_static_map_over_iframe", "label": "Static Map Image over an Embedded Iframe", "file_type": "rationale", "source_file": "Requirement/IMPLEMENTATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An iframe loads several hundred kilobytes of third-party JavaScript and sets cookies on a page that only needs to show an address; a photo plus a link does the job and keeps the page free of third-party requests."}, {"id": "requirement_implementation_plan_build_cost_warning", "label": "Gallery Build Cost Warning", "file_type": "rationale", "source_file": "Requirement/IMPLEMENTATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A folder of 4000px phone photos turns a thirty-second build into several minutes on Cloudflare's free tier, so source files must be downscaled to at most 2000px on the long edge before bulk uploads."}, {"id": "requirement_implementation_plan_optional_committee_photos", "label": "Committee Photos Are Optional", "file_type": "rationale", "source_file": "Requirement/IMPLEMENTATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The roster must render correctly when every member lacks a photo: committee photos are the most likely thing never to be supplied, so the layout must not collapse without images."}, {"id": "requirement_implementation_plan_verification_drills", "label": "Verification Drills", "file_type": "document", "source_file": "Requirement/IMPLEMENTATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bulletin drill, roster drill, Lighthouse on the heaviest album, a link sweep, a JavaScript-disabled pass, and a real phone on campus wifi. The final gate is handing the README to someone who did not build the site: if they get stuck, the README is wrong, not the person."}], "edges": [{"source": "requirement_implementation_plan_schema_as_test_suite", "target": "requirement_tech_stack_content_collections", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "Requirement/IMPLEMENTATION_PLAN.md", "source_location": null, "weight": 1.0}, {"source": "requirement_implementation_plan_build_cost_warning", "target": "contributing_photo_size_limit", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "Requirement/IMPLEMENTATION_PLAN.md", "source_location": null, "weight": 1.0}, {"source": "requirement_implementation_plan_decisions_log", "target": "requirement_tech_stack_open_decision_bulletin", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Requirement/IMPLEMENTATION_PLAN.md", "source_location": null, "weight": 1.0}, {"source": "requirement_implementation_plan_decisions_log", "target": "requirement_tech_stack_git_cms_deferred", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Requirement/IMPLEMENTATION_PLAN.md", "source_location": null, "weight": 1.0}, {"source": "requirement_implementation_plan_decisions_log", "target": "requirement_most_holy_redeemer_church__tanjung_malim_website_sitemap", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Requirement/IMPLEMENTATION_PLAN.md", "source_location": null, "weight": 1.0}, {"source": "requirement_implementation_plan_m1_i18n_core", "target": "requirement_tech_stack_language_switcher", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "Requirement/IMPLEMENTATION_PLAN.md", "source_location": null, "weight": 1.0}, {"source": "requirement_implementation_plan_m1_i18n_core", "target": "requirement_tech_stack_ui_string_table", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "Requirement/IM